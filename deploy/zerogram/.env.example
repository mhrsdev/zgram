# Copy to .env (mode 600). scripts/install.sh fills in ZEROGRAM_MASTER_KEY for you.
# Never commit .env: it holds the key that encrypts every TOTP secret.

# Address clients dial: your server's IP or domain name (inside Iran). Required.
ZEROGRAM_PUBLIC_ADDRESS=203.0.113.10
ZEROGRAM_PORT=5222

# 32 random bytes, base64. Generated by scripts/install.sh. KEEP A COPY OUTSIDE THE SERVER:
# without it the stored authenticator secrets cannot be decrypted (users would need recovery codes).
ZEROGRAM_MASTER_KEY=

# Server owner password (>= 12 characters, random). Generated by scripts/install.sh. It is entered in the app
# under "Sign in as server owner" together with the server IP; it never travels over the network.
ZEROGRAM_OWNER_PASSWORD=
# Name users see for this server in the app (the IP itself is never shown to users)
ZEROGRAM_SERVER_NAME=Zerogram
# Host port for the owner key-bootstrap endpoint; keep it equal to ZEROGRAM_PORT + 1
ZEROGRAM_BOOTSTRAP_PORT_HOST=5223

# Name shown in Google Authenticator
ZEROGRAM_ISSUER=Zerogram

# Undelivered-message queue
ZEROGRAM_QUEUE_TTL_HOURS=168
ZEROGRAM_QUEUE_MAX_MESSAGES_PER_USER=10000
ZEROGRAM_QUEUE_MAX_BYTES_PER_USER=67108864
ZEROGRAM_QUEUE_MAX_TOTAL_BYTES=4294967296

# Limits
ZEROGRAM_GROUP_MEMBER_LIMIT=50
ZEROGRAM_MAX_REGISTRATIONS_PER_IP=30
ZEROGRAM_MAX_ATTEMPTS_PER_IP=300

# Container resources
ZEROGRAM_CPUS=2.0
ZEROGRAM_MEMORY=3g
