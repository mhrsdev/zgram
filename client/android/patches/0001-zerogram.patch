@@ -0,0 +1,45 @@
+package org.telegram.zerogram;
+
+import android.content.Context;
+
+import org.telegram.messenger.R;
+import org.telegram.tgnet.TLRPC;
+
+/** Turns server error codes into user-facing text. */
+final class ZgErrors {
+
+    private ZgErrors() {
+    }
+
+    static String describe(Context context, TLRPC.TL_error error) {
+        String text = error.text == null ? "" : error.text;
+        if (text.startsWith("FLOOD_WAIT_")) {
+            int seconds = 60;
+            try {
+                seconds = Integer.parseInt(text.substring("FLOOD_WAIT_".length()));
+            } catch (NumberFormatException ignore) {
+            }
+            String when = seconds >= 120 ? (seconds / 60) + " min" : seconds + " s";
+            return String.format(context.getString(R.string.ZgErrFlood), when);
+        }
+        switch (text) {
+            case "TOKEN_INVALID":
+                return context.getString(R.string.ZgErrTokenInvalid);
+            case "USER_ALREADY_PARTICIPANT":
+                return context.getString(R.string.ZgErrAlreadyMember);
+            case "USERS_TOO_MUCH":
+                return context.getString(R.string.ZgErrGroupFull);
+            case "OWNER_INVALID":
+                return context.getString(R.string.ZgOwnerBadLogin);
+            case "OWNER_DISABLED":
+                return context.getString(R.string.ZgOwnerDisabled);
+            case "CHAT_ADMIN_REQUIRED":
+                return context.getString(R.string.ZgErrForbidden);
+            default:
+                if (error.code == -1000 || error.code == -2000 || error.code == -3000) {
+                    return context.getString(R.string.ZgErrNetwork);
+                }
+                return String.format(context.getString(R.string.ZgErrGeneric), text.isEmpty() ? String.valueOf(error.code) : text);
+        }
+    }
+}
