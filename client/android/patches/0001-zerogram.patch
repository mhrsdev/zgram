index 0000000000000000000000000000000000000000..281088b15a5ed612daf9fd0646116ba46c345adb
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/zerogram/ZgConnectMessage.java
@@ -0,0 +1,65 @@
+package org.telegram.zerogram;
+
+import android.util.Base64;
+
+import org.json.JSONObject;
+
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+
+import javax.crypto.Cipher;
+import javax.crypto.spec.GCMParameterSpec;
+import javax.crypto.spec.SecretKeySpec;
+
+/**
+ * Opens the "connection message" a server owner gives to users ({@code zg1.<base64url>}). It carries the
+ * server address and public key in an opaque, authenticated text so users never see or type the IP.
+ *
+ * <p>The AES key is a constant shared with the server source (see ZgConnectMessage.cs). It keeps the
+ * address out of sight of ordinary users and makes the text tamper-evident; it is not a secret against
+ * someone who reverse-engineers this app or watches the network.
+ */
+public final class ZgConnectMessage {
+
+    public static final String PREFIX = "zg1.";
+
+    private ZgConnectMessage() {
+    }
+
+    /** Returns the endpoint described by the message, or null when it is not a valid message. */
+    public static ZgConfig.Endpoint open(String message) {
+        try {
+            StringBuilder compact = new StringBuilder();
+            for (int i = 0; message != null && i < message.length(); i++) {
+                char c = message.charAt(i);
+                if (!Character.isWhitespace(c)) {
+                    compact.append(c);
+                }
+            }
+            String text = compact.toString();
+            if (!text.startsWith(PREFIX)) {
+                return null;
+            }
+            byte[] raw = Base64.decode(text.substring(PREFIX.length()), Base64.URL_SAFE | Base64.NO_WRAP);
+            if (raw.length < 12 + 16 + 2) {
+                return null;
+            }
+            byte[] key = MessageDigest.getInstance("SHA-256").digest(
+                    "zerogram-connect-message-v1/shared-obfuscation-key".getBytes(StandardCharsets.UTF_8));
+            Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
+            cipher.init(Cipher.DECRYPT_MODE, new SecretKeySpec(key, "AES"), new GCMParameterSpec(128, raw, 0, 12));
+            cipher.updateAAD("zg-connect".getBytes(StandardCharsets.UTF_8));
+            byte[] plain = cipher.doFinal(raw, 12, raw.length - 12);
+            JSONObject json = new JSONObject(new String(plain, StandardCharsets.UTF_8));
+            String host = json.getString("h");
+            int port = json.getInt("p");
+            byte[] der = Base64.decode(json.getString("k"), Base64.DEFAULT);
+            if (host.isEmpty() || port < 1 || port > 65535) {
+                return null;
+            }
+            return ZgConfig.fromKey(host, port, der, json.optString("n", ""), ZgConfig.ROLE_USER);
+        } catch (Throwable e) {
+            return null;
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/zerogram/ZgDelivery.java b/TMessagesProj/src/main/java/org/telegram/zerogram/ZgDelivery.java
