@@ -0,0 +1,62 @@
+package org.telegram.zerogram;
+
+import android.widget.TextView;
+
+import org.telegram.messenger.R;
+
+/** Shows the installed and the latest version and updates with one tap. */
+public class ZgUpdateActivity extends ZgPageFragment {
+
+    private TextView status;
+
+    @Override
+    protected void onCreateContent() {
+        render();
+        if (ZgUpdater.available() == null) {
+            // Opened from settings: look again right now.
+            status.setText(str(R.string.ZgUpdateChecking));
+            ZgUpdater.check(true, () -> {
+                if (fragmentView != null) {
+                    render();
+                }
+            });
+        }
+    }
+
+    private void render() {
+        clear();
+        title(str(R.string.ZgUpdateTitle));
+        body(String.format(str(R.string.ZgUpdateInstalled), ZgUpdater.installedVersion()));
+        final ZgUpdater.Release release = ZgUpdater.available();
+        status = body(release == null ? str(R.string.ZgUpdateUpToDate) : String.format(str(R.string.ZgUpdateAvailableText), release.version, ZgUpdater.installedVersion()));
+        if (release != null) {
+            if (release.notes != null && !release.notes.trim().isEmpty()) {
+                body(release.notes.trim());
+            }
+            errorLine();
+            button(str(R.string.ZgUpdateNow), () -> startUpdate(release), true);
+        } else {
+            errorLine();
+            button(str(R.string.ZgUpdateCheckAgain), () -> ZgUpdater.check(true, this::render), false);
+        }
+        body(str(R.string.ZgUpdateNote));
+    }
+
+    private void startUpdate(ZgUpdater.Release release) {
+        if (getParentActivity() == null) {
+            return;
+        }
+        showError(null);
+        setBusy(true);
+        ZgUpdater.downloadAndInstall(getParentActivity(), release,
+                (text, percent) -> status.setText(text + " " + percent + "%"),
+                error -> {
+                    setBusy(false);
+                    if (error != null) {
+                        showError(error);
+                    } else {
+                        status.setText(str(R.string.ZgUpdateInstalling));
+                    }
+                });
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/zerogram/ZgUpdater.java b/TMessagesProj/src/main/java/org/telegram/zerogram/ZgUpdater.java
new file mode 100644
index 0000000000000000000000000000000000000000..1be42b82789491f8eff7f1073b2544fec784ff29
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/zerogram/ZgUpdater.java
@@ -0,0 +1,400 @@
+package org.telegram.zerogram;
+
+import android.app.Activity;
+import android.content.Context;
+import android.content.Intent;
+import android.content.SharedPreferences;
+import android.content.pm.PackageInfo;
+import android.content.pm.PackageManager;
+import android.content.pm.Signature;
+import android.net.Uri;
+import android.os.Build;
+import android.provider.Settings;
+
+import androidx.core.content.FileProvider;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.R;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.LaunchActivity;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.net.HttpURLConnection;
+import java.net.URL;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.Set;
+
+/**
+ * Update check against the GitHub releases of the public Zerogram repository, and a one-tap update.
+ *
+ * <p>This is strictly optional: messaging never depends on it. The check runs in the background, fails
+ * silently when GitHub cannot be reached (for example inside a closed network) and never blocks sign-in.
+ *
+ * <p>Before the installer is started the downloaded APK is verified: its SHA-256 must match the digest GitHub
+ * publishes for the asset (or the {@code .sha256} asset next to it), it must be this app's package and it
+ * must carry the same signing certificate as the installed app. Android itself refuses an update signed
+ * with a different key.
+ */
+public final class ZgUpdater {
+
+    public static final String REPOSITORY = "mhrsdev/zgram";
+    private static final String API_URL = "https://api.github.com/repos/" + REPOSITORY + "/releases/latest";
+    private static final long CHECK_INTERVAL_MS = 6L * 60 * 60 * 1000;
+
+    public static final class Release {
+        public String tag;
+        public String version;
+        public String notes;
+        public String apkUrl;
+        public String apkName;
+        public long apkSize;
+        /** Lower-case hex; may be empty when the release publishes no digest (then it is not installable). */
+        public String sha256;
+    }
+
+    public interface Progress {
+        void update(String stageText, int percent);
+    }
+
+    public interface Finished {
+        /** error is null when the installer was started. */
+        void done(String error);
+    }
+
+    private static volatile Release available;
+    private static volatile boolean checking;
+    private static String promptedTag = "";
+
+    private ZgUpdater() {
+    }
+
+    public static Release available() {
+        return available;
+    }
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences("zerogram_update", Context.MODE_PRIVATE);
+    }
+
+    /** Called once per process start; the first check is delayed so it never competes with sign-in. */
+    public static void scheduleCheck() {
+        AndroidUtilities.runOnUIThread(() -> check(false, null), 20_000);
+    }
+
+    public static void check(boolean force, Runnable onFinished) {
+        if (checking) {
+            return;
+        }
+        long last = prefs().getLong("last_check", 0);
+        if (!force && System.currentTimeMillis() - last < CHECK_INTERVAL_MS && available == null) {
+            return;
+        }
+        checking = true;
+        new Thread(() -> {
+            Release found = null;
+            boolean ok = false;
+            try {
+                found = fetchLatest();
+                ok = true;
+            } catch (Throwable ignore) {
+                // Offline / GitHub unreachable / rate limited: stay silent.
+            }
+            final Release result = found;
+            final boolean succeeded = ok;
+            AndroidUtilities.runOnUIThread(() -> {
+                checking = false;
+                if (succeeded) {
+                    prefs().edit().putLong("last_check", System.currentTimeMillis()).apply();
+                    available = result != null && isNewer(result.version, installedVersion()) ? result : null;
+                    if (available != null && LaunchActivity.instance != null) {
+                        maybePrompt(LaunchActivity.instance);
+                    }
+                }
+                if (onFinished != null) {
+                    onFinished.run();
+                }
+            });
+        }, "zg-update-check").start();
+    }
+
+    public static String installedVersion() {
+        try {
+            Context c = ApplicationLoader.applicationContext;
+            return c.getPackageManager().getPackageInfo(c.getPackageName(), 0).versionName;
+        } catch (Throwable e) {
+            return "0";
+        }
+    }
+
+    /** Shows the "new version" dialog once per release, from the foreground activity. */
+    public static void maybePrompt(LaunchActivity activity) {
+        Release release = available;
+        if (release == null || release.tag.equals(promptedTag) || activity.isFinishing()) {
+            return;
+        }
+        promptedTag = release.tag;
+        AlertDialog.Builder builder = new AlertDialog.Builder(activity);
+        builder.setTitle(activity.getString(R.string.ZgUpdateAvailable));
+        builder.setMessage(String.format(activity.getString(R.string.ZgUpdateAvailableText), release.version, installedVersion()));
+        builder.setPositiveButton(activity.getString(R.string.ZgUpdateNow), (dialog, which) -> activity.presentFragment(new ZgUpdateActivity()));
+        builder.setNegativeButton(activity.getString(R.string.ZgUpdateLater), null);
+        builder.show();
+    }
+
+    // ------------------------------------------------------------------ check
+
+    private static Release fetchLatest() throws Exception {
+        JSONObject json = new JSONObject(httpGetText(API_URL));
+        Release release = new Release();
+        release.tag = json.optString("tag_name", "");
+        release.version = release.tag.replaceFirst("^[vV]", "");
+        release.notes = json.optString("body", "");
+        if (release.tag.isEmpty() || json.optBoolean("draft", false) || json.optBoolean("prerelease", false)) {
+            return null;
+        }
+        JSONArray assets = json.optJSONArray("assets");
+        if (assets == null) {
+            return null;
+        }
+        JSONObject apk = null;
+        String abi = Build.SUPPORTED_ABIS != null && Build.SUPPORTED_ABIS.length > 0 ? Build.SUPPORTED_ABIS[0] : "";
+        for (int i = 0; i < assets.length(); i++) {
+            JSONObject asset = assets.getJSONObject(i);
+            String name = asset.optString("name", "");
+            if (!name.toLowerCase(Locale.ROOT).endsWith(".apk")) {
+                continue;
+            }
+            if (name.contains(abi)) {
+                apk = asset;
+                break;
+            }
+            if (apk == null && !name.contains("arm") && !name.contains("x86")) {
+                apk = asset; // universal build
+            }
+        }
+        if (apk == null) {
+            return null;
+        }
+        release.apkName = apk.getString("name");
+        release.apkUrl = apk.getString("browser_download_url");
+        release.apkSize = apk.optLong("size", 0);
+        String digest = apk.optString("digest", "");
+        if (digest.startsWith("sha256:")) {
+            release.sha256 = digest.substring(7).toLowerCase(Locale.ROOT);
+        } else {
+            release.sha256 = "";
+            for (int i = 0; i < assets.length(); i++) {
+                JSONObject asset = assets.getJSONObject(i);
+                if ((release.apkName + ".sha256").equals(asset.optString("name"))) {
+                    String line = httpGetText(asset.getString("browser_download_url")).trim();
+                    String first = line.split("\\s+")[0].toLowerCase(Locale.ROOT);
+                    if (first.matches("[0-9a-f]{64}")) {
+                        release.sha256 = first;
+                    }
+                }
+            }
+        }
+        return release;
+    }
+
+    /** True when {@code candidate} (e.g. "1.2.0") is newer than {@code current}. */
+    static boolean isNewer(String candidate, String current) {
+        int[] a = numbers(candidate);
+        int[] b = numbers(current);
+        for (int i = 0; i < Math.max(a.length, b.length); i++) {
+            int x = i < a.length ? a[i] : 0;
+            int y = i < b.length ? b[i] : 0;
+            if (x != y) {
+                return x > y;
+            }
+        }
+        return false;
+    }
+
+    private static int[] numbers(String version) {
+        String[] parts = (version == null ? "" : version).split("[^0-9]+");
+        int count = 0;
+        int[] out = new int[parts.length];
+        for (String part : parts) {
+            if (!part.isEmpty()) {
+                try {
+                    out[count++] = Integer.parseInt(part);
+                } catch (NumberFormatException ignore) {
+                }
+            }
+        }
+        int[] trimmed = new int[count];
+        System.arraycopy(out, 0, trimmed, 0, count);
+        return trimmed;
+    }
+
+    private static String httpGetText(String url) throws Exception {
+        HttpURLConnection connection = open(url);
+        try (InputStream in = connection.getInputStream()) {
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] buffer = new byte[4096];
+            int n;
+            while ((n = in.read(buffer)) > 0 && out.size() < 2_000_000) {
+                out.write(buffer, 0, n);
+            }
+            return new String(out.toByteArray(), StandardCharsets.UTF_8);
+        } finally {
+            connection.disconnect();
+        }
+    }
+
+    private static HttpURLConnection open(String url) throws Exception {
+        HttpURLConnection connection = (HttpURLConnection) new URL(url).openConnection();
+        connection.setConnectTimeout(10_000);
+        connection.setReadTimeout(20_000);
+        connection.setInstanceFollowRedirects(true);
+        connection.setRequestProperty("Accept", "application/vnd.github+json");
+        connection.setRequestProperty("User-Agent", "Zerogram-Android");
+        return connection;
+    }
+
+    // ------------------------------------------------------------------ download + install
+
+    /** Downloads, verifies and hands the APK to the system installer. */
+    public static void downloadAndInstall(Activity activity, Release release, Progress progress, Finished finished) {
+        if (release.sha256 == null || release.sha256.isEmpty()) {
+            finished.done(activity.getString(R.string.ZgUpdateNoDigest));
+            return;
+        }
+        new Thread(() -> {
+            String error = null;
+            File apk = null;
+            try {
+                File dir = new File(ApplicationLoader.getFilesDirFixed(), "cache/zg-update");
+                //noinspection ResultOfMethodCallIgnored
+                dir.mkdirs();
+                File[] old = dir.listFiles();
+                if (old != null) {
+                    for (File f : old) {
+                        //noinspection ResultOfMethodCallIgnored
+                        f.delete();
+                    }
+                }
+                apk = new File(dir, "update.apk");
+                MessageDigest sha = MessageDigest.getInstance("SHA-256");
+                HttpURLConnection connection = open(release.apkUrl);
+                connection.setRequestProperty("Accept", "application/octet-stream");
+                long total = connection.getContentLengthLong() > 0 ? connection.getContentLengthLong() : release.apkSize;
+                try (InputStream in = connection.getInputStream(); FileOutputStream out = new FileOutputStream(apk)) {
+                    byte[] buffer = new byte[64 * 1024];
+                    long done = 0;
+                    int lastPercent = -1;
+                    int n;
+                    while ((n = in.read(buffer)) > 0) {
+                        out.write(buffer, 0, n);
+                        sha.update(buffer, 0, n);
+                        done += n;
+                        int percent = total > 0 ? (int) (done * 100 / total) : 0;
+                        if (percent != lastPercent) {
+                            lastPercent = percent;
+                            final int p = percent;
+                            AndroidUtilities.runOnUIThread(() -> progress.update(activity.getString(R.string.ZgUpdateDownloading), p));
+                        }
+                    }
+                    out.getFD().sync();
+                } finally {
+                    connection.disconnect();
+                }
+                if (!hex(sha.digest()).equalsIgnoreCase(release.sha256)) {
+                    error = activity.getString(R.string.ZgUpdateBadDigest);
+                } else if (!sameSigner(activity, apk)) {
+                    error = activity.getString(R.string.ZgUpdateBadSigner);
+                }
+            } catch (Throwable t) {
+                error = activity.getString(R.string.ZgUpdateDownloadFailed);
+            }
+            final String failure = error;
+            final File file = apk;
+            AndroidUtilities.runOnUIThread(() -> {
+                if (failure != null) {
+                    if (file != null) {
+                        //noinspection ResultOfMethodCallIgnored
+                        file.delete();
+                    }
+                    finished.done(failure);
+                    return;
+                }
+                finished.done(install(activity, file));
+            });
+        }, "zg-update-download").start();
+    }
+
+    private static String install(Activity activity, File apk) {
+        try {
+            if (Build.VERSION.SDK_INT >= 26 && !activity.getPackageManager().canRequestPackageInstalls()) {
+                Intent settings = new Intent(Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES, Uri.parse("package:" + activity.getPackageName()));
+                activity.startActivity(settings);
+                return activity.getString(R.string.ZgUpdateAllowInstall);
+            }
+            Uri uri = FileProvider.getUriForFile(activity, activity.getPackageName() + ".provider", apk);
+            Intent intent = new Intent(Intent.ACTION_VIEW);
+            intent.setDataAndType(uri, "application/vnd.android.package-archive");
+            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION | Intent.FLAG_ACTIVITY_NEW_TASK);
+            activity.startActivity(intent);
+            return null;
+        } catch (Throwable t) {
+            return activity.getString(R.string.ZgUpdateInstallFailed);
+        }
+    }
+
+    private static boolean sameSigner(Context context, File apk) {
+        try {
+            PackageManager pm = context.getPackageManager();
+            Set<String> mine;
+            Set<String> theirs;
+            if (Build.VERSION.SDK_INT >= 28) {
+                PackageInfo installed = pm.getPackageInfo(context.getPackageName(), PackageManager.GET_SIGNING_CERTIFICATES);
+                PackageInfo archive = pm.getPackageArchiveInfo(apk.getAbsolutePath(), PackageManager.GET_SIGNING_CERTIFICATES);
+                if (archive == null || !context.getPackageName().equals(archive.packageName)
+                        || installed.signingInfo == null || archive.signingInfo == null) {
+                    return false;
+                }
+                mine = fingerprints(installed.signingInfo.getApkContentsSigners());
+                theirs = fingerprints(archive.signingInfo.getApkContentsSigners());
+            } else {
+                PackageInfo installed = pm.getPackageInfo(context.getPackageName(), PackageManager.GET_SIGNATURES);
+                PackageInfo archive = pm.getPackageArchiveInfo(apk.getAbsolutePath(), PackageManager.GET_SIGNATURES);
+                if (archive == null || !context.getPackageName().equals(archive.packageName)) {
+                    return false;
+                }
+                mine = fingerprints(installed.signatures);
+                theirs = fingerprints(archive.signatures);
+            }
+            return !mine.isEmpty() && mine.equals(theirs);
+        } catch (Throwable t) {
+            return false;
+        }
+    }
+
+    private static Set<String> fingerprints(Signature[] signatures) throws Exception {
+        Set<String> out = new HashSet<>();
+        if (signatures != null) {
+            for (Signature s : signatures) {
+                out.add(hex(MessageDigest.getInstance("SHA-256").digest(s.toByteArray())));
+            }
+        }
+        return out;
+    }
+
+    private static String hex(byte[] data) {
+        StringBuilder sb = new StringBuilder();
+        for (byte b : data) {
+            sb.append(String.format(Locale.ROOT, "%02x", b));
+        }
+        return sb.toString();
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/zerogram/ZgWelcomeActivity.java b/TMessagesProj/src/main/java/org/telegram/zerogram/ZgWelcomeActivity.java
new file mode 100644
index 0000000000000000000000000000000000000000..0dab1be48060e21e7fb2842a2e4dee41c44c16f2
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/zerogram/ZgWelcomeActivity.java
@@ -0,0 +1,234 @@
+package org.telegram.zerogram;
+
+import android.text.InputType;
+import android.widget.EditText;
+import android.widget.Toast;
+
+import org.json.JSONObject;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.R;
+import org.telegram.messenger.UserConfig;
+
+import java.io.ByteArrayOutputStream;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+
+/**
+ * First screen: "sign in as a user" (join a server with the owner's encrypted connection message and,
+ * optionally, a group token) or "sign in as a server owner" (server IP + the owner's 12 words). Also used to
+ * add another server later; each server occupies its own account slot.
+ */
+public class ZgWelcomeActivity extends ZgPageFragment {
+
+    private static final int PAGE_HOME = 0;
+    private static final int PAGE_USER = 1;
+    private static final int PAGE_OWNER = 2;
+
+    private int page = PAGE_HOME;
+    private EditText messageField;
+    private EditText tokenField;
+    private EditText ipField;
+    private EditText wordsField;
+
+    public ZgWelcomeActivity() {
+        super();
+    }
+
+    public ZgWelcomeActivity(int account) {
+        super(account);
+    }
+
+    @Override
+    protected void onCreateContent() {
+        show(PAGE_HOME);
+    }
+
+    @Override
+    public boolean onBackPressed(boolean invoked) {
+        if (busy) {
+            return false;
+        }
+        if (page != PAGE_HOME) {
+            show(PAGE_HOME);
+            return false;
+        }
+        return true;
+    }
+
+    private void show(int newPage) {
+        page = newPage;
+        clear();
+        switch (newPage) {
+            case PAGE_USER:
+                buildUser();
+                break;
+            case PAGE_OWNER:
+                buildOwner();
+                break;
+            default:
+                buildHome();
+        }
+    }
+
+    private void buildHome() {
+        title(str(R.string.ZgWelcomeTitle));
+        body(str(R.string.ZgWelcomeSubtitle));
+        button(str(R.string.ZgRoleUser), () -> show(PAGE_USER), true);
+        body(str(R.string.ZgRoleUserHint)).setPadding(0, AndroidUtilities.dp(6), 0, AndroidUtilities.dp(10));
+        button(str(R.string.ZgRoleOwner), () -> show(PAGE_OWNER), true);
+        body(str(R.string.ZgRoleOwnerHint)).setPadding(0, AndroidUtilities.dp(6), 0, 0);
+        if (ZgSession.hasOtherSignedInAccount(currentAccount) || isPresentedOverApp()) {
+            button(str(R.string.ZgCancelAddServer), this::finishFragment, false);
+        }
+    }
+
+    private boolean isPresentedOverApp() {
+        return parentLayout != null && parentLayout.getFragmentStack().size() > 1;
+    }
+
+    // ------------------------------------------------------------------ user
+
+    private void buildUser() {
+        title(str(R.string.ZgUserJoinTitle));
+        body(str(R.string.ZgUserJoinHelp));
+        messageField = field(str(R.string.ZgHintConnectMessage), InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS, 4000);
+        messageField.setMinLines(3);
+        button(str(R.string.ZgPaste), () -> messageField.setText(paste().trim()), false);
+        tokenField = field(str(R.string.ZgHintGroupToken), InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS, 64);
+        errorLine();
+        button(str(R.string.ZgContinue), this::onUserContinue, true);
+        button(str(R.string.ZgBack), () -> show(PAGE_HOME), false);
+    }
+
+    private void onUserContinue() {
+        ZgConfig.Endpoint endpoint = ZgConnectMessage.open(text(messageField));
+        if (endpoint == null) {
+            showError(str(R.string.ZgConnectMessageInvalid));
+            return;
+        }
+        String token = digitsOnly(text(tokenField));
+        if (!token.isEmpty() && token.length() != 32) {
+            showError(str(R.string.ZgErrTokenInvalid));
+            return;
+        }
+        if (alreadyAdded(endpoint)) {
+            showError(str(R.string.ZgServerAlready));
+            return;
+        }
+        try {
+            ZgSession.setPendingJoinToken(currentAccount, token);
+            ZgSession.addServerAndRestart(currentAccount, endpoint);
+        } catch (Exception e) {
+            showError(str(R.string.ZgConnectMessageInvalid));
+        }
+    }
+
+    private boolean alreadyAdded(ZgConfig.Endpoint endpoint) {
+        for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+            ZgConfig.Endpoint other = ZgConfig.read(a);
+            if (other != null && other.role.equals(endpoint.role) && endpoint.sameServer(other)) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // ------------------------------------------------------------------ owner
+
+    private void buildOwner() {
+        title(str(R.string.ZgOwnerTitle));
+        body(str(R.string.ZgOwnerHelp));
+        ipField = field(str(R.string.ZgHintServerIp), InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_URI | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS, 300);
+        wordsField = field(str(R.string.ZgHintOwnerWords), InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS, 400);
+        wordsField.setMinLines(2);
+        button(str(R.string.ZgPaste), () -> wordsField.setText(paste().trim()), false);
+        errorLine();
+        button(str(R.string.ZgOwnerConnect), this::onOwnerConnect, true);
+        button(str(R.string.ZgBack), () -> show(PAGE_HOME), false);
+    }
+
+    private void onOwnerConnect() {
+        final String address = text(ipField);
+        if (address.isEmpty() || text(wordsField).isEmpty()) {
+            showError(str(R.string.ZgErrFill));
+            return;
+        }
+        // Checked on the phone first: unknown words or a wrong checksum never reach the network.
+        final String words = ZgBip39.normalize(text(wordsField));
+        if (words == null) {
+            showError(str(R.string.ZgOwnerWordsInvalid));
+            return;
+        }
+        final Object[] hostPort;
+        try {
+            hostPort = ZgConfig.parseAddress(address);
+        } catch (Exception e) {
+            showError(str(R.string.ZgOwnerKeyFailed));
+            return;
+        }
+        final String host = (String) hostPort[0];
+        final int port = (Integer) hostPort[1];
+        showError(null);
+        setBusy(true);
+        new Thread(() -> {
+            ZgConfig.Endpoint endpoint = null;
+            try {
+                endpoint = fetchKey(host, port);
+            } catch (Throwable ignore) {
+            }
+            final ZgConfig.Endpoint found = endpoint;
+            AndroidUtilities.runOnUIThread(() -> {
+                setBusy(false);
+                if (found == null) {
+                    showError(str(R.string.ZgOwnerKeyFailed));
+                    return;
+                }
+                if (alreadyAdded(found)) {
+                    showError(str(R.string.ZgServerAlready));
+                    return;
+                }
+                try {
+                    ZgSession.setPendingOwnerWords(currentAccount, words);
+                    ZgSession.addServerAndRestart(currentAccount, found);
+                } catch (Exception e) {
+                    showError(str(R.string.ZgOwnerKeyFailed));
+                }
+            });
+        }, "zg-owner-bootstrap").start();
+    }
+
+    /**
+     * The server publishes its (public) RSA key on the MTProto port + 1. Nothing is trusted from this
+     * channel alone: the owner proof is bound to the key fingerprint and to the 12 words. A raw socket is
+     * used because Android forbids plain-HTTP requests through its HTTP stack.
+     */
+    private static ZgConfig.Endpoint fetchKey(String host, int port) throws Exception {
+        try (java.net.Socket socket = new java.net.Socket()) {
+            socket.connect(new java.net.InetSocketAddress(host, port + 1), 8000);
+            socket.setSoTimeout(8000);
+            java.io.OutputStream request = socket.getOutputStream();
+            request.write(("GET /zg/key HTTP/1.0\r\nHost: " + host + "\r\nConnection: close\r\n\r\n")
+                    .getBytes(StandardCharsets.US_ASCII));
+            request.flush();
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            InputStream in = socket.getInputStream();
+            byte[] buffer = new byte[2048];
+            int n;
+            while ((n = in.read(buffer)) > 0 && out.size() < 16384) {
+                out.write(buffer, 0, n);
+            }
+            String response = new String(out.toByteArray(), StandardCharsets.UTF_8);
+            int split = response.indexOf("\r\n\r\n");
+            if (split < 0 || !response.startsWith("HTTP/") || !response.substring(0, Math.min(response.length(), 20)).contains(" 200")) {
+                return null;
+            }
+            JSONObject json = new JSONObject(response.substring(split + 4));
+            byte[] der = android.util.Base64.decode(json.getString("key"), android.util.Base64.DEFAULT);
+            ZgConfig.Endpoint endpoint = ZgConfig.fromKey(host, port, der, "", ZgConfig.ROLE_OWNER);
+            if (!endpoint.fingerprintHex.equalsIgnoreCase(json.optString("fp", ""))) {
+                return null;
+            }
+            return endpoint;
+        }
+    }
+}
