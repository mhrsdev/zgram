diff --git a/TMessagesProj/src/main/java/org/telegram/zerogram/ZgAck.java b/TMessagesProj/src/main/java/org/telegram/zerogram/ZgAck.java
new file mode 100644
index 0000000000000000000000000000000000000000..a4a98a162fe498e89d4ca69336b8722c5caa78d8
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/zerogram/ZgAck.java
@@ -0,0 +1,146 @@
+package org.telegram.zerogram;
+
+import org.telegram.SQLite.SQLiteCursor;
+import org.telegram.SQLite.SQLiteDatabase;
+import org.telegram.SQLite.SQLitePreparedStatement;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.MessagesStorage;
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.tgnet.TLRPC;
+
+import java.util.ArrayList;
+
+/**
+ * Delivery acknowledgement. The server keeps a message only until this device confirms it stored it.
+ *
+ * <ol>
+ *   <li>{@link #recordInTransaction} runs <b>inside the same SQLite transaction</b> that stores incoming
+ *       messages, so an id is in the ledger if and only if its message is durably in the local database.</li>
+ *   <li>{@link #flush} sends the ledger to the server ({@code zg.ackMessages}) and deletes the entries the
+ *       server confirmed. Failures leave the ledger untouched; it is retried on every reconnect and on a
+ *       timer, and survives app restarts.</li>
+ * </ol>
+ * An acknowledgement is therefore never sent for a message that is not on this device, and a lost
+ * acknowledgement only delays the server's cleanup (it also expires on its own).
+ */
+public final class ZgAck {
+
+    private static final int BATCH = 400;
+    private static final long RETRY_MS = 30_000;
+
+    private ZgAck() {
+    }
+
+    public static void createTable(SQLiteDatabase database) throws Exception {
+        database.executeFast("CREATE TABLE IF NOT EXISTS zg_ack_pending(mid INTEGER PRIMARY KEY, ts INTEGER)")
+                .stepThis().dispose();
+    }
+
+    /** Must be called from the storage queue, inside the transaction that stores {@code messages}. */
+    public static void recordInTransaction(SQLiteDatabase database, ArrayList<TLRPC.Message> messages) {
+        if (messages == null || messages.isEmpty()) {
+            return;
+        }
+        SQLitePreparedStatement statement = null;
+        try {
+            statement = database.executeFast("INSERT OR IGNORE INTO zg_ack_pending VALUES(?, ?)");
+            int now = (int) (System.currentTimeMillis() / 1000);
+            for (int i = 0, n = messages.size(); i < n; i++) {
+                TLRPC.Message message = messages.get(i);
+                if (message == null || message.id <= 0 || message instanceof TLRPC.TL_messageEmpty) {
+                    continue;
+                }
+                statement.requery();
+                statement.bindInteger(1, message.id);
+                statement.bindInteger(2, now);
+                statement.step();
+            }
+        } catch (Exception e) {
+            FileLog.e(e);
+        } finally {
+            if (statement != null) {
+                statement.dispose();
+            }
+        }
+    }
+
+    /** Called (from the storage queue) after a transaction that stored messages was committed. */
+    public static void afterCommit(int account) {
+        AndroidUtilities.runOnUIThread(() -> flush(account));
+    }
+
+    public static void flush(int account) {
+        if (!ZgConfig.isConfigured(account)) {
+            return;
+        }
+        final MessagesStorage storage = MessagesStorage.getInstance(account);
+        storage.getStorageQueue().postRunnable(() -> {
+            final ArrayList<Integer> ids = new ArrayList<>();
+            SQLiteCursor cursor = null;
+            try {
+                cursor = storage.getDatabase().queryFinalized("SELECT mid FROM zg_ack_pending ORDER BY mid LIMIT " + BATCH);
+                while (cursor.next()) {
+                    ids.add(cursor.intValue(0));
+                }
+            } catch (Exception e) {
+                FileLog.e(e);
+            } finally {
+                if (cursor != null) {
+                    cursor.dispose();
+                }
+            }
+            if (ids.isEmpty()) {
+                return;
+            }
+            TL_zg.ackMessages request = new TL_zg.ackMessages();
+            request.ids = ids;
+            ConnectionsManager.getInstance(account).sendRequest(request, (response, error) -> {
+                if (response instanceof TL_zg.AckResult) {
+                    storage.getStorageQueue().postRunnable(() -> {
+                        try {
+                            StringBuilder list = new StringBuilder();
+                            for (int i = 0; i < ids.size(); i++) {
+                                if (i > 0) {
+                                    list.append(',');
+                                }
+                                list.append(ids.get(i));
+                            }
+                            storage.getDatabase().executeFast("DELETE FROM zg_ack_pending WHERE mid IN (" + list + ")")
+                                    .stepThis().dispose();
+                        } catch (Exception e) {
+                            FileLog.e(e);
+                        }
+                        if (ids.size() >= BATCH) {
+                            AndroidUtilities.runOnUIThread(() -> flush(account));
+                        }
+                    });
+                }
+                // On error (offline, not logged in) the ledger stays; the next trigger retries.
+            }, ConnectionsManager.RequestFlagFailOnServerErrors);
+        });
+    }
+
+    /** Re-tries on reconnect and periodically for as long as the process lives. */
+    public static void start(int account) {
+        NotificationCenter.getInstance(account).addObserver(new NotificationCenter.NotificationCenterDelegate() {
+            @Override
+            public void didReceivedNotification(int id, int acc, Object... args) {
+                if (id == NotificationCenter.didUpdateConnectionState
+                        && ConnectionsManager.getInstance(account).getConnectionState() == ConnectionsManager.ConnectionStateConnected) {
+                    flush(account);
+                    ZgDelivery.sync(account);
+                }
+            }
+        }, NotificationCenter.didUpdateConnectionState);
+        Runnable tick = new Runnable() {
+            @Override
+            public void run() {
+                flush(account);
+                AndroidUtilities.runOnUIThread(this, RETRY_MS);
+            }
+        };
+        AndroidUtilities.runOnUIThread(tick, 5_000);
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/zerogram/ZgAuthActivity.java b/TMessagesProj/src/main/java/org/telegram/zerogram/ZgAuthActivity.java
