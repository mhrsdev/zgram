index 0000000000000000000000000000000000000000..c9b18c603cb4de9a487d64afcdc2de39b77777eb
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/zerogram/ZgBip39.java
@@ -0,0 +1,123 @@
+package org.telegram.zerogram;
+
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.R;
+
+import java.io.BufferedReader;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+
+/**
+ * The server owner is identified by 12 words (BIP-39 English list, 128-bit entropy + 4-bit checksum). The owner
+ * key the sign-in proof uses is derived from them exactly as the server does:
+ * K = HMAC-SHA256(PBKDF2-HMAC-SHA512(phrase, "mnemonic", 2048, 64), "zerogram/owner/v1").
+ */
+final class ZgBip39 {
+
+    private static List<String> words;
+    private static Map<String, Integer> index;
+
+    private ZgBip39() {
+    }
+
+    private static synchronized void load() throws Exception {
+        if (words != null) {
+            return;
+        }
+        List<String> list = new ArrayList<>(2048);
+        try (InputStream in = ApplicationLoader.applicationContext.getResources().openRawResource(R.raw.zg_bip39_english);
+             BufferedReader reader = new BufferedReader(new InputStreamReader(in, StandardCharsets.UTF_8))) {
+            String line;
+            while ((line = reader.readLine()) != null) {
+                line = line.trim();
+                if (!line.isEmpty()) {
+                    list.add(line);
+                }
+            }
+        }
+        if (list.size() != 2048) {
+            throw new IllegalStateException("word list");
+        }
+        Map<String, Integer> map = new HashMap<>();
+        for (int i = 0; i < list.size(); i++) {
+            map.put(list.get(i), i);
+        }
+        words = list;
+        index = map;
+    }
+
+    /** Lower-cases and collapses whitespace; null unless it is 12 known words with a correct checksum. */
+    static String normalize(String input) {
+        try {
+            load();
+            String[] parts = (input == null ? "" : input).trim().toLowerCase(Locale.ROOT).split("\\s+");
+            if (parts.length != 12) {
+                return null;
+            }
+            boolean[] bits = new boolean[132];
+            for (int w = 0; w < 12; w++) {
+                Integer i = index.get(parts[w]);
+                if (i == null) {
+                    return null;
+                }
+                for (int b = 0; b < 11; b++) {
+                    bits[w * 11 + b] = ((i >> (10 - b)) & 1) == 1;
+                }
+            }
+            byte[] entropy = new byte[16];
+            for (int i = 0; i < 128; i++) {
+                if (bits[i]) {
+                    entropy[i / 8] |= (byte) (1 << (7 - i % 8));
+                }
+            }
+            byte checksum = MessageDigest.getInstance("SHA-256").digest(entropy)[0];
+            for (int i = 0; i < 4; i++) {
+                if (bits[128 + i] != (((checksum >> (7 - i)) & 1) == 1)) {
+                    return null;
+                }
+            }
+            return String.join(" ", parts);
+        } catch (Throwable t) {
+            return null;
+        }
+    }
+
+    /** The 32-byte owner key for an already normalized phrase. Slow (PBKDF2): call off the UI thread. */
+    static byte[] ownerKey(String normalized) throws Exception {
+        byte[] seed = pbkdf2Sha512(normalized.getBytes(StandardCharsets.UTF_8), "mnemonic".getBytes(StandardCharsets.UTF_8), 2048, 64);
+        Mac mac = Mac.getInstance("HmacSHA256");
+        mac.init(new SecretKeySpec(seed, "HmacSHA256"));
+        return mac.doFinal("zerogram/owner/v1".getBytes(StandardCharsets.UTF_8));
+    }
+
+    static byte[] pbkdf2Sha512(byte[] password, byte[] salt, int iterations, int length) throws Exception {
+        Mac mac = Mac.getInstance("HmacSHA512");
+        mac.init(new SecretKeySpec(password, "HmacSHA512"));
+        byte[] out = new byte[length];
+        int blocks = (length + 63) / 64;
+        for (int block = 1; block <= blocks; block++) {
+            mac.update(salt);
+            mac.update(new byte[]{(byte) (block >>> 24), (byte) (block >>> 16), (byte) (block >>> 8), (byte) block});
+            byte[] u = mac.doFinal();
+            byte[] t = u.clone();
+            for (int i = 1; i < iterations; i++) {
+                u = mac.doFinal(u);
+                for (int j = 0; j < t.length; j++) {
+                    t[j] ^= u[j];
+                }
+            }
+            System.arraycopy(t, 0, out, (block - 1) * 64, Math.min(64, length - (block - 1) * 64));
+        }
+        return out;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/zerogram/ZgConfig.java b/TMessagesProj/src/main/java/org/telegram/zerogram/ZgConfig.java
new file mode 100644
index 0000000000000000000000000000000000000000..f7a239670deccc506575662823a040d69378f933
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/zerogram/ZgConfig.java
@@ -0,0 +1,423 @@
+package org.telegram.zerogram;
+
+import android.content.Context;
+import android.content.Intent;
+import android.net.Uri;
+import android.util.Base64;
+
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.UserConfig;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.math.BigInteger;
+import java.nio.charset.StandardCharsets;
+import java.security.KeyFactory;
+import java.security.MessageDigest;
+import java.security.interfaces.RSAPublicKey;
+import java.security.spec.X509EncodedKeySpec;
+import java.util.Properties;
+
+/**
+ * The one server this app talks to. The address and RSA public key are chosen by the operator/user and
+ * stored in {@code zerogram.properties}, which the native networking layer reads at start-up. There are no
+ * built-in addresses or keys of any other service.
+ */
+public final class ZgConfig {
+
+    public static final String FILE_NAME = "zerogram.properties";
+    public static final int DEFAULT_PORT = 5222;
+    public static final String ROLE_USER = "user";
+    public static final String ROLE_OWNER = "owner";
+
+    private ZgConfig() {
+    }
+
+    public static final class Endpoint {
+        public final String host;
+        public final int port;
+        public final String pkcs1Base64;
+        public final String fingerprintHex;
+        /** Label shown to the user instead of the address (the address itself is never displayed). */
+        public final String name;
+        /** {@link #ROLE_USER} or {@link #ROLE_OWNER}. */
+        public final String role;
+
+        Endpoint(String host, int port, String pkcs1Base64, String fingerprintHex) {
+            this(host, port, pkcs1Base64, fingerprintHex, "", ROLE_USER);
+        }
+
+        Endpoint(String host, int port, String pkcs1Base64, String fingerprintHex, String name, String role) {
+            this.host = host;
+            this.port = port;
+            this.pkcs1Base64 = pkcs1Base64;
+            this.fingerprintHex = fingerprintHex;
+            this.name = name == null ? "" : name;
+            this.role = ROLE_OWNER.equals(role) ? ROLE_OWNER : ROLE_USER;
+        }
+
+        public Endpoint with(String name, String role) {
+            return new Endpoint(host, port, pkcs1Base64, fingerprintHex, name, role);
+        }
+
+        public boolean isOwner() {
+            return ROLE_OWNER.equals(role);
+        }
+
+        public boolean sameServer(Endpoint other) {
+            return other != null && host.equalsIgnoreCase(other.host) && port == other.port
+                    && fingerprintHex.equalsIgnoreCase(other.fingerprintHex);
+        }
+    }
+
+    /** Same directory the native networking layer uses for this account (see ConnectionsManager.init). */
+    static File dir(int account) {
+        File base = ApplicationLoader.getFilesDirFixed();
+        if (account == 0) {
+            return base;
+        }
+        File dir = new File(base, "account" + account);
+        //noinspection ResultOfMethodCallIgnored
+        dir.mkdirs();
+        return dir;
+    }
+
+    private static File file(int account) {
+        return new File(dir(account), FILE_NAME);
+    }
+
+    public static synchronized Endpoint read(int account) {
+        File f = file(account);
+        if (!f.isFile()) {
+            return null;
+        }
+        try (FileInputStream in = new FileInputStream(f)) {
+            Properties p = new Properties();
+            p.load(in);
+            String host = p.getProperty("zg.host", "").trim();
+            int port = Integer.parseInt(p.getProperty("zg.port", "0").trim());
+            String pem = p.getProperty("zg.pem", "").trim();
+            String fp = p.getProperty("zg.fingerprint", "").trim();
+            if (host.isEmpty() || port <= 0 || pem.isEmpty() || fp.length() != 16) {
+                return null;
+            }
+            return new Endpoint(host, port, pem, fp, p.getProperty("zg.name", ""), p.getProperty("zg.role", ROLE_USER));
+        } catch (Throwable e) {
+            return null;
+        }
+    }
+
+    public static boolean isConfigured(int account) {
+        return read(account) != null;
+    }
+
+    public static Endpoint read() {
+        return read(UserConfig.selectedAccount);
+    }
+
+    public static boolean isConfigured() {
+        return isConfigured(UserConfig.selectedAccount);
+    }
+
+    /** "host", "host:port" or "[v6]:port". Returns {host, port}. */
+    static Object[] parseAddress(String address) {
+        String a = address.trim();
+        if (a.isEmpty()) {
+            throw new IllegalArgumentException("address");
+        }
+        int port = DEFAULT_PORT;
+        String host = a;
+        if (a.startsWith("[")) {
+            int end = a.indexOf(']');
+            if (end < 0) {
+                throw new IllegalArgumentException("address");
+            }
+            host = a.substring(1, end);
+            if (a.length() > end + 1) {
+                if (a.charAt(end + 1) != ':') {
+                    throw new IllegalArgumentException("address");
+                }
+                port = Integer.parseInt(a.substring(end + 2));
+            }
+        } else if (a.indexOf(':') >= 0 && a.indexOf(':') == a.lastIndexOf(':')) {
+            host = a.substring(0, a.indexOf(':'));
+            port = Integer.parseInt(a.substring(a.indexOf(':') + 1));
+        }
+        if (host.isEmpty() || port < 1 || port > 65535) {
+            throw new IllegalArgumentException("address");
+        }
+        return new Object[]{host, port};
+    }
+
+    /**
+     * Accepts either a {@code zerogram://host:port?key=BASE64URL} link (printed by the server and also
+     * encodable as a QR code), or an address plus a PEM / base64 RSA public key.
+     */
+    public static Endpoint parse(String addressOrLink, String keyText) {
+        String address = addressOrLink == null ? "" : addressOrLink.trim();
+        String key = keyText == null ? "" : keyText.trim();
+        if (address.startsWith("zerogram://")) {
+            Uri uri = Uri.parse(address);
+            String hostPort = uri.getEncodedAuthority();
+            String k = uri.getQueryParameter("key");
+            if (hostPort == null || k == null) {
+                throw new IllegalArgumentException("link");
+            }
+            address = hostPort;
+            key = k;
+        }
+        Object[] hp = parseAddress(address);
+        byte[] der = decodeKey(key);
+        BigInteger[] ne = readRsa(der);
+        return new Endpoint((String) hp[0], (Integer) hp[1],
+                Base64.encodeToString(encodePkcs1(ne[0], ne[1]), Base64.NO_WRAP),
+                fingerprint(ne[0], ne[1]));
+    }
+
+    /** Builds an endpoint from a raw RSA public key (PKCS#1 or SubjectPublicKeyInfo DER). */
+    public static Endpoint fromKey(String host, int port, byte[] der, String name, String role) {
+        BigInteger[] ne = readRsa(der);
+        return new Endpoint(host, port, Base64.encodeToString(encodePkcs1(ne[0], ne[1]), Base64.NO_WRAP),
+                fingerprint(ne[0], ne[1]), name, role);
+    }
+
+    /** The MTProto key fingerprint as the 8 raw little-endian bytes the owner proof is bound to. */
+    public static byte[] fingerprintBytes(Endpoint e) {
+        long value = Long.parseUnsignedLong(e.fingerprintHex, 16);
+        byte[] out = new byte[8];
+        for (int i = 0; i < 8; i++) {
+            out[i] = (byte) (value >>> (8 * i));
+        }
+        return out;
+    }
+
+    private static byte[] decodeKey(String key) {
+        String body = key.replace("-----BEGIN PUBLIC KEY-----", "")
+                .replace("-----END PUBLIC KEY-----", "")
+                .replace("-----BEGIN RSA PUBLIC KEY-----", "")
+                .replace("-----END RSA PUBLIC KEY-----", "")
+                .replaceAll("\\s+", "");
+        if (body.isEmpty()) {
+            throw new IllegalArgumentException("key");
+        }
+        try {
+            return Base64.decode(body, Base64.URL_SAFE | Base64.NO_WRAP | Base64.NO_PADDING);
+        } catch (IllegalArgumentException e) {
+            return Base64.decode(body, Base64.DEFAULT);
+        }
+    }
+
+    /** Reads SubjectPublicKeyInfo or PKCS#1 RSAPublicKey. */
+    private static BigInteger[] readRsa(byte[] der) {
+        try {
+            RSAPublicKey pub = (RSAPublicKey) KeyFactory.getInstance("RSA").generatePublic(new X509EncodedKeySpec(der));
+            return new BigInteger[]{pub.getModulus(), pub.getPublicExponent()};
+        } catch (Exception ignore) {
+        }
+        int[] pos = {0};
+        expect(der, pos, 0x30);
+        readLength(der, pos);
+        BigInteger n = readInteger(der, pos);
+        BigInteger e = readInteger(der, pos);
+        return new BigInteger[]{n, e};
+    }
+
+    private static void expect(byte[] d, int[] pos, int tag) {
+        if (pos[0] >= d.length || (d[pos[0]++] & 0xff) != tag) {
+            throw new IllegalArgumentException("key");
+        }
+    }
+
+    private static int readLength(byte[] d, int[] pos) {
+        int b = d[pos[0]++] & 0xff;
+        if (b < 0x80) {
+            return b;
+        }
+        int count = b & 0x7f;
+        int len = 0;
+        for (int i = 0; i < count; i++) {
+            len = (len << 8) | (d[pos[0]++] & 0xff);
+        }
+        return len;
+    }
+
+    private static BigInteger readInteger(byte[] d, int[] pos) {
+        expect(d, pos, 0x02);
+        int len = readLength(d, pos);
+        byte[] v = new byte[len];
+        System.arraycopy(d, pos[0], v, 0, len);
+        pos[0] += len;
+        return new BigInteger(1, v);
+    }
+
+    private static byte[] derInteger(BigInteger v) {
+        byte[] raw = v.toByteArray(); // two's complement: a leading 0 appears when the top bit is set
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        out.write(0x02);
+        writeLength(out, raw.length);
+        out.write(raw, 0, raw.length);
+        return out.toByteArray();
+    }
+
+    private static void writeLength(ByteArrayOutputStream out, int len) {
+        if (len < 0x80) {
+            out.write(len);
+        } else if (len < 0x100) {
+            out.write(0x81);
+            out.write(len);
+        } else {
+            out.write(0x82);
+            out.write(len >> 8);
+            out.write(len & 0xff);
+        }
+    }
+
+    static byte[] encodePkcs1(BigInteger n, BigInteger e) {
+        byte[] body;
+        ByteArrayOutputStream inner = new ByteArrayOutputStream();
+        byte[] ni = derInteger(n);
+        byte[] ei = derInteger(e);
+        inner.write(ni, 0, ni.length);
+        inner.write(ei, 0, ei.length);
+        body = inner.toByteArray();
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        out.write(0x30);
+        writeLength(out, body.length);
+        out.write(body, 0, body.length);
+        return out.toByteArray();
+    }
+
+    /** MTProto key fingerprint: low 64 bits of SHA-1(TL-bytes(n) || TL-bytes(e)). */
+    static String fingerprint(BigInteger n, BigInteger e) {
+        try {
+            ByteArrayOutputStream tl = new ByteArrayOutputStream();
+            writeTlBytes(tl, unsigned(n));
+            writeTlBytes(tl, unsigned(e));
+            byte[] sha = MessageDigest.getInstance("SHA-1").digest(tl.toByteArray());
+            long value = 0;
+            for (int i = 7; i >= 0; i--) {
+                value = (value << 8) | (sha[12 + i] & 0xff); // little-endian read of the last 8 bytes
+            }
+            return String.format("%016x", value);
+        } catch (Exception ex) {
+            throw new IllegalStateException(ex);
+        }
+    }
+
+    private static byte[] unsigned(BigInteger v) {
+        byte[] raw = v.toByteArray();
+        if (raw.length > 1 && raw[0] == 0) {
+            byte[] trimmed = new byte[raw.length - 1];
+            System.arraycopy(raw, 1, trimmed, 0, trimmed.length);
+            return trimmed;
+        }
+        return raw;
+    }
+
+    private static void writeTlBytes(ByteArrayOutputStream out, byte[] data) {
+        int header;
+        if (data.length < 254) {
+            out.write(data.length);
+            header = 1;
+        } else {
+            out.write(254);
+            out.write(data.length & 0xff);
+            out.write((data.length >> 8) & 0xff);
+            out.write((data.length >> 16) & 0xff);
+            header = 4;
+        }
+        out.write(data, 0, data.length);
+        int pad = (4 - ((header + data.length) % 4)) % 4;
+        for (int i = 0; i < pad; i++) {
+            out.write(0);
+        }
+    }
+
+    /** Persists the endpoint for an account slot; the native layer reads it when the process starts. */
+    public static synchronized void save(int account, Endpoint endpoint) throws java.io.IOException {
+        Properties p = new Properties();
+        p.setProperty("zg.host", endpoint.host);
+        p.setProperty("zg.port", String.valueOf(endpoint.port));
+        p.setProperty("zg.pem", endpoint.pkcs1Base64);
+        p.setProperty("zg.fingerprint", endpoint.fingerprintHex);
+        p.setProperty("zg.name", endpoint.name);
+        p.setProperty("zg.role", endpoint.role);
+        File target = file(account);
+        File temp = new File(target.getParentFile(), FILE_NAME + ".tmp");
+        try (FileOutputStream out = new FileOutputStream(temp)) {
+            p.store(out, "Zerogram server (private, do not share)");
+            out.getFD().sync();
+        }
+        if (!temp.renameTo(target)) {
+            throw new java.io.IOException("cannot store server settings");
+        }
+        // Auth keys negotiated with a previous server are useless (and confusing) with this one.
+        deleteAuthKeys(account);
+    }
+
+    /** Updates only the display label (keeps the auth keys, unlike {@link #save(int, Endpoint)}). */
+    public static synchronized void updateName(int account, String name) {
+        Endpoint current = read(account);
+        if (current == null || current.name.equals(name)) {
+            return;
+        }
+        Properties p = new Properties();
+        File f = file(account);
+        try (FileInputStream in = new FileInputStream(f)) {
+            p.load(in);
+        } catch (Throwable e) {
+            return;
+        }
+        p.setProperty("zg.name", name == null ? "" : name);
+        File temp = new File(f.getParentFile(), FILE_NAME + ".tmp");
+        try (FileOutputStream out = new FileOutputStream(temp)) {
+            p.store(out, "Zerogram server (private, do not share)");
+            out.getFD().sync();
+            //noinspection ResultOfMethodCallIgnored
+            temp.renameTo(f);
+        } catch (Throwable ignore) {
+        }
+    }
+
+    public static synchronized void save(Endpoint endpoint) throws java.io.IOException {
+        save(UserConfig.selectedAccount, endpoint);
+    }
+
+    /** Forgets the server of an account slot (the native layer falls back to a closed loopback port). */
+    public static synchronized void remove(int account) {
+        //noinspection ResultOfMethodCallIgnored
+        file(account).delete();
+        deleteAuthKeys(account);
+    }
+
+    private static void deleteAuthKeys(int account) {
+        File[] stale = dir(account).listFiles((d, name) -> name.startsWith("tgnet.dat"));
+        if (stale != null) {
+            for (File s : stale) {
+                //noinspection ResultOfMethodCallIgnored
+                s.delete();
+            }
+        }
+    }
+
+    /** The connection link a server operator hands to users ({@code zerogram://host:port?key=...}). */
+    public static String toLink(Endpoint e) {
+        // The link carries PKCS#1 DER in URL-safe base64.
+        byte[] der = Base64.decode(e.pkcs1Base64, Base64.DEFAULT);
+        String key = Base64.encodeToString(der, Base64.URL_SAFE | Base64.NO_WRAP | Base64.NO_PADDING);
+        String host = e.host.indexOf(':') >= 0 ? "[" + e.host + "]" : e.host;
+        return "zerogram://" + host + ":" + e.port + "?key=" + key;
+    }
+
+    /** Restarts the process so the native layer re-reads the settings. */
+    public static void restart(Context context) {
+        Intent intent = context.getPackageManager().getLaunchIntentForPackage(context.getPackageName());
+        if (intent != null) {
+            intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK);
+            context.startActivity(intent);
+        }
+        android.os.Process.killProcess(android.os.Process.myPid());
+    }
+}
