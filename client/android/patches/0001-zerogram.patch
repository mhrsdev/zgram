+package org.telegram.zerogram;
+
+import android.content.Context;
+import android.widget.Toast;
+
+import org.telegram.messenger.AccountInstance;
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.R;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.tgnet.TLRPC;
+
+/** Joins a group with its 32-digit token. */
+public final class ZgJoin {
+
+    public interface Result {
+        void done(TLRPC.TL_error error);
+    }
+
+    private ZgJoin() {
+    }
+
+    public static void join(int account, String token, Result result) {
+        TL_zg.joinGroup request = new TL_zg.joinGroup();
+        request.token = token;
+        ConnectionsManager.getInstance(account).sendRequest(request, (response, error) -> {
+            if (error == null && response instanceof TLRPC.Updates) {
+                AccountInstance.getInstance(account).getMessagesController().processUpdates((TLRPC.Updates) response, false);
+            }
+            AndroidUtilities.runOnUIThread(() -> result.done(error));
+        }, ConnectionsManager.RequestFlagFailOnServerErrors);
+    }
+
+    /** Redeems the token that was typed together with the connection message, right after sign-in. */
+    static void redeemPending(int account) {
+        String token = ZgSession.takePendingJoinToken(account);
+        if (token.isEmpty()) {
+            return;
+        }
+        Context context = ApplicationLoader.applicationContext;
+        join(account, token, error -> {
+            String message = error == null ? context.getString(R.string.ZgJoined) : ZgErrors.describe(context, error);
+            Toast.makeText(context, message, Toast.LENGTH_LONG).show();
+        });
+    }
+}
