+package org.telegram.zerogram;
+
+import org.telegram.messenger.R;
+import org.telegram.tgnet.TLObject;
+
+/** The join token of a group, for the person who created it. */
+public class ZgGroupTokenActivity extends ZgPageFragment {
+
+    private final long chatId;
+
+    public ZgGroupTokenActivity(long chatId) {
+        super();
+        this.chatId = chatId;
+    }
+
+    @Override
+    protected void onCreateContent() {
+        load(false);
+    }
+
+    private void load(boolean rotate) {
+        clear();
+        title(str(R.string.ZgGroupTokenTitle));
+        errorLine();
+        TLObject request;
+        if (rotate) {
+            TL_zg.rotateGroupToken r = new TL_zg.rotateGroupToken();
+            r.chat_id = chatId;
+            request = r;
+        } else {
+            TL_zg.getGroupToken r = new TL_zg.getGroupToken();
+            r.chat_id = chatId;
+            request = r;
+        }
+        call(request, false, (TLObject response) -> {
+            if (!(response instanceof TL_zg.GroupToken)) {
+                return;
+            }
+            TL_zg.GroupToken group = (TL_zg.GroupToken) response;
+            clear();
+            title(str(R.string.ZgGroupTokenTitle));
+            body(str(R.string.ZgGroupTokenHelp));
+            mono(groupDigits(group.token));
+            button(str(R.string.ZgCopy), () -> copy(group.token), false);
+            button(str(R.string.ZgShare), () -> share(str(R.string.ZgGroupTokenLabel) + ":\n" + groupDigits(group.token)), false);
+            button(str(R.string.ZgRotate), () -> load(true), false);
+            errorLine();
+        });
+    }
+}
