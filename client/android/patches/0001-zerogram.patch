+package org.telegram.zerogram;
+
+import android.text.InputType;
+import android.widget.EditText;
+import android.widget.Toast;
+
+import org.telegram.messenger.R;
+
+/** Join a group of the current server with its 32-digit token. */
+public class ZgJoinGroupActivity extends ZgPageFragment {
+
+    private EditText tokenField;
+
+    public ZgJoinGroupActivity() {
+        super();
+    }
+
+    @Override
+    protected void onCreateContent() {
+        title(str(R.string.ZgJoinTitle));
+        body(str(R.string.ZgJoinHelp));
+        tokenField = field(str(R.string.ZgHintGroupTokenRequired), InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS, 64);
+        button(str(R.string.ZgPaste), () -> tokenField.setText(paste().trim()), false);
+        errorLine();
+        button(str(R.string.ZgJoinButton), this::onJoin, true);
+    }
+
+    private void onJoin() {
+        String token = digitsOnly(text(tokenField));
+        if (token.length() != 32) {
+            showError(str(R.string.ZgErrTokenInvalid));
+            return;
+        }
+        showError(null);
+        setBusy(true);
+        ZgJoin.join(currentAccount, token, error -> {
+            setBusy(false);
+            if (error != null) {
+                showError(ZgErrors.describe(ctx(), error));
+                return;
+            }
+            Toast.makeText(ctx(), str(R.string.ZgJoined), Toast.LENGTH_LONG).show();
+            finishFragment();
+        });
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/zerogram/ZgOwner.java b/TMessagesProj/src/main/java/org/telegram/zerogram/ZgOwner.java
new file mode 100644
index 0000000000000000000000000000000000000000..83c79a2c0d8db6c1da4f94c62e1b93c5115873e0
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/zerogram/ZgOwner.java
@@ -0,0 +1,98 @@
+package org.telegram.zerogram;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.tgnet.TLObject;
+import org.telegram.tgnet.TLRPC;
+
+import java.io.ByteArrayOutputStream;
+import java.security.MessageDigest;
+import java.security.SecureRandom;
+import java.nio.charset.StandardCharsets;
+
+import javax.crypto.Mac;
+import javax.crypto.spec.SecretKeySpec;
+
+/**
+ * Owner sign-in: a mutual HMAC proof keyed by the owner key derived from the 12 words. The words never leave
+ * the phone.
+ * Both proofs cover the server's RSA key fingerprint, so a server (or middleman) holding another key cannot
+ * produce a valid proof for this endpoint.
+ */
+final class ZgOwner {
+
+    interface Callback {
+        /** error is null on success; otherwise a TL error or a synthetic one (text OWNER_INVALID). */
+        void done(TLRPC.TL_auth_authorization authorization, TLRPC.TL_error error);
+    }
+
+    private ZgOwner() {
+    }
+
+    static void login(int account, ZgConfig.Endpoint endpoint, String mnemonic, Callback callback) {
+        final byte[] clientNonce = new byte[16];
+        new SecureRandom().nextBytes(clientNonce);
+        TL_zg.ownerHello hello = new TL_zg.ownerHello();
+        hello.client_nonce = clientNonce;
+        ConnectionsManager.getInstance(account).sendRequest(hello, (response, error) -> {
+            if (error != null || !(response instanceof TL_zg.OwnerChallenge)) {
+                post(callback, null, error != null ? error : synthetic("OWNER_INVALID"));
+                return;
+            }
+            final TL_zg.OwnerChallenge challenge = (TL_zg.OwnerChallenge) response;
+            // Deriving the key from the 12 words (PBKDF2, 2048 rounds) is slow: keep it off the network thread.
+            new Thread(() -> {
+                try {
+                    String normalized = ZgBip39.normalize(mnemonic);
+                    if (normalized == null) {
+                        post(callback, null, synthetic("OWNER_INVALID"));
+                        return;
+                    }
+                    byte[] key = ZgBip39.ownerKey(normalized);
+                    byte[] fp = ZgConfig.fingerprintBytes(endpoint);
+                    byte[] expected = proof(key, "zg-owner-srv", clientNonce, challenge.server_nonce, fp);
+                    if (!MessageDigest.isEqual(expected, challenge.server_proof)) {
+                        // Wrong words or a server that is not the one holding this key.
+                        post(callback, null, synthetic("OWNER_INVALID"));
+                        return;
+                    }
+                    TL_zg.ownerLogin login = new TL_zg.ownerLogin();
+                    login.client_nonce = clientNonce;
+                    login.server_nonce = challenge.server_nonce;
+                    login.client_proof = proof(key, "zg-owner-cli", clientNonce, challenge.server_nonce, fp);
+                    ConnectionsManager.getInstance(account).sendRequest(login, (r, e) -> {
+                        if (e == null && r instanceof TLRPC.TL_auth_authorization) {
+                            post(callback, (TLRPC.TL_auth_authorization) r, null);
+                        } else {
+                            post(callback, null, e != null ? e : synthetic("OWNER_INVALID"));
+                        }
+                    }, ConnectionsManager.RequestFlagFailOnServerErrors | ConnectionsManager.RequestFlagWithoutLogin);
+                } catch (Throwable t) {
+                    post(callback, null, synthetic("OWNER_INVALID"));
+                }
+            }, "zg-owner-kdf").start();
+        }, ConnectionsManager.RequestFlagFailOnServerErrors | ConnectionsManager.RequestFlagWithoutLogin);
+    }
+
+    private static void post(Callback callback, TLRPC.TL_auth_authorization auth, TLRPC.TL_error error) {
+        AndroidUtilities.runOnUIThread(() -> callback.done(auth, error));
+    }
+
+    private static TLRPC.TL_error synthetic(String text) {
+        TLRPC.TL_error error = new TLRPC.TL_error();
+        error.code = 400;
+        error.text = text;
+        return error;
+    }
+
+    static byte[] proof(byte[] key, String label, byte[] clientNonce, byte[] serverNonce, byte[] fingerprint) throws Exception {
+        ByteArrayOutputStream data = new ByteArrayOutputStream();
+        data.write(label.getBytes(StandardCharsets.US_ASCII));
+        data.write(clientNonce);
+        data.write(serverNonce);
+        data.write(fingerprint);
+        Mac mac = Mac.getInstance("HmacSHA256");
+        mac.init(new SecretKeySpec(key, "HmacSHA256"));
+        return mac.doFinal(data.toByteArray());
+    }
+}
