+package org.telegram.zerogram;
+
+import android.widget.Toast;
+
+import org.telegram.messenger.R;
+import org.telegram.messenger.UserConfig;
+import org.telegram.ui.LaunchActivity;
+
+/** The servers this account list is connected to; each server is its own account slot. */
+public class ZgServersActivity extends ZgPageFragment {
+
+    public ZgServersActivity() {
+        super();
+    }
+
+    @Override
+    protected void onCreateContent() {
+        title(str(R.string.ZgServersTitle));
+        body(str(R.string.ZgServersHelp));
+        for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+            final int account = a;
+            ZgConfig.Endpoint endpoint = ZgConfig.read(a);
+            if (endpoint == null) {
+                continue;
+            }
+            String name = endpoint.name.isEmpty() ? str(R.string.ZgAppName) : endpoint.name;
+            StringBuilder label = new StringBuilder(name);
+            if (endpoint.isOwner()) {
+                label.append(" · ").append(str(R.string.ZgServerOwnerBadge));
+            }
+            boolean signedIn = UserConfig.getInstance(a).isClientActivated();
+            if (a == UserConfig.selectedAccount && signedIn) {
+                label.append(" ✓");
+            } else if (!signedIn) {
+                label.append(" · ").append(str(R.string.ZgServerNotSignedIn));
+            }
+            button(label.toString(), () -> open(account), true);
+        }
+        button(str(R.string.ZgServersAdd), this::addServer, false);
+    }
+
+    private void open(int account) {
+        if (account == UserConfig.selectedAccount) {
+            finishFragment();
+            return;
+        }
+        if (UserConfig.getInstance(account).isClientActivated() && getParentActivity() instanceof LaunchActivity) {
+            ((LaunchActivity) getParentActivity()).switchToAccount(account, true);
+            return;
+        }
+        ZgSession.selectAccountForNextStart(account);
+        ZgConfig.restart(ctx().getApplicationContext());
+    }
+
+    private void addServer() {
+        int free = ZgSession.firstFreeAccount();
+        if (free < 0) {
+            Toast.makeText(ctx(), str(R.string.ZgNoFreeSlot), Toast.LENGTH_LONG).show();
+            return;
+        }
+        presentFragment(new ZgWelcomeActivity(free));
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/zerogram/ZgSession.java b/TMessagesProj/src/main/java/org/telegram/zerogram/ZgSession.java
new file mode 100644
index 0000000000000000000000000000000000000000..dd95d1505d756e4b0df909952c9e189e61a66d2c
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/zerogram/ZgSession.java
@@ -0,0 +1,184 @@
+package org.telegram.zerogram;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.os.Bundle;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.ContactsController;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.MessagesController;
+import org.telegram.messenger.MessagesStorage;
+import org.telegram.messenger.NotificationCenter;
+import org.telegram.messenger.UserConfig;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.MainTabsActivity;
+
+import java.util.ArrayList;
+
+/**
+ * Account/session glue.
+ *
+ * <p><b>History belongs to the device.</b> Signing out (or being signed out because a newer login revoked
+ * this session) clears credentials but leaves the local message database untouched. The database is wiped
+ * only when a <em>different</em> account signs in on this installation, or when the server is changed,
+ * because its contents would belong to somebody else.
+ */
+public final class ZgSession {
+
+    private static final String PREFS = "zerogram";
+    private static final String KEY_DB_OWNER = "db_owner_user_id";
+    private static final String KEY_PENDING_TOKEN = "pending_join_token_";
+    private static final String KEY_PENDING_OWNER = "pending_owner_words_";
+
+    private ZgSession() {
+    }
+
+    private static SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    public static long databaseOwner(int account) {
+        return prefs().getLong(KEY_DB_OWNER + (account == 0 ? "" : "_" + account), 0);
+    }
+
+    public static void forgetDatabaseOwner(int account) {
+        prefs().edit().putLong(KEY_DB_OWNER + (account == 0 ? "" : "_" + account), 0).commit();
+    }
+
+    // ------------------------------------------------------------------ server slots
+
+    /** Which account slot is the active one the next time the app starts. */
+    public static void selectAccountForNextStart(int account) {
+        UserConfig.selectedAccount = account;
+        ApplicationLoader.applicationContext.getSharedPreferences("userconfing", Context.MODE_PRIVATE)
+                .edit().putInt("selectedAccount", account).commit();
+    }
+
+    /** First slot without a server (and not signed in), or -1 when all slots are used. */
+    public static int firstFreeAccount() {
+        for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+            if (!UserConfig.getInstance(a).isClientActivated() && !ZgConfig.isConfigured(a)) {
+                return a;
+            }
+        }
+        return -1;
+    }
+
+    /**
+     * Stores the server of an account slot and restarts the app so the native networking layer (which reads
+     * the address and key once per process) connects to it. The slot becomes the active one.
+     */
+    public static void addServerAndRestart(int account, ZgConfig.Endpoint endpoint) throws java.io.IOException {
+        ZgConfig.save(account, endpoint);
+        forgetDatabaseOwner(account);
+        selectAccountForNextStart(account);
+        ZgConfig.restart(ApplicationLoader.applicationContext);
+    }
+
+    /** Join token typed together with the connection message; redeemed right after the first sign-in. */
+    public static void setPendingJoinToken(int account, String token) {
+        prefs().edit().putString(KEY_PENDING_TOKEN + account, token == null ? "" : token).commit();
+    }
+
+    public static String takePendingJoinToken(int account) {
+        String token = prefs().getString(KEY_PENDING_TOKEN + account, "");
+        if (!token.isEmpty()) {
+            prefs().edit().remove(KEY_PENDING_TOKEN + account).commit();
+        }
+        return token;
+    }
+
+    /**
+     * The owner password has to survive the restart that points the app at the new server. It is kept in
+     * app-private storage only until the sign-in that follows the restart takes (and deletes) it.
+     */
+    public static void setPendingOwnerWords(int account, String password) {
+        prefs().edit().putString(KEY_PENDING_OWNER + account, password).commit();
+    }
+
+    public static String takePendingOwnerWords(int account) {
+        String password = prefs().getString(KEY_PENDING_OWNER + account, "");
+        if (!password.isEmpty()) {
+            prefs().edit().remove(KEY_PENDING_OWNER + account).commit();
+        }
+        return password;
+    }
+
+    /** Called once per process after the account objects exist (see ApplicationLoader). */
+    public static void onAppStart() {
+        for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+            ZgAck.start(a);
+        }
+    }
+
+    public static void completeLogin(int account, TLRPC.User user, Runnable onDone) {
+        final boolean sameOwner = databaseOwner(account) == user.id;
+        MessagesController controller = MessagesController.getInstance(account);
+        controller.cleanup();
+        ConnectionsManager.getInstance(account).setUserId(user.id);
+        UserConfig config = UserConfig.getInstance(account);
+        config.clearConfig();
+        controller.cleanup();
+        config.syncContacts = false;
+        config.setCurrentUser(user);
+        config.saveConfig(true);
+        if (sameOwner) {
+            // Same person coming back: keep the stored history and just catch up with the server.
+            MessagesStorage.getInstance(account).getStorageQueue().postRunnable(
+                    () -> org.telegram.messenger.Utilities.stageQueue.postRunnable(() -> controller.getDifference()));
+        } else {
+            MessagesStorage.getInstance(account).cleanup(true);
+        }
+        prefs().edit().putLong(KEY_DB_OWNER + (account == 0 ? "" : "_" + account), user.id).commit();
+        ArrayList<TLRPC.User> users = new ArrayList<>();
+        users.add(user);
+        MessagesStorage.getInstance(account).putUsersAndChats(users, null, true, true);
+        controller.putUser(user, false);
+        ConnectionsManager.getInstance(account).updateDcSettings();
+        controller.loadAppConfig();
+        ZgAck.flush(account);
+        ZgDelivery.sync(account);
+        ZgJoin.redeemPending(account);
+        onDone.run();
+    }
+
+    /**
+     * Gives up on an account slot that never signed in (wrong server, cancelled): forgets its server and
+     * restarts into another account, or into the welcome screen when none exists.
+     */
+    public static void abandonAccountAndRestart(int account) {
+        ZgConfig.remove(account);
+        forgetDatabaseOwner(account);
+        int target = 0;
+        for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+            if (a != account && UserConfig.getInstance(a).isClientActivated()) {
+                target = a;
+                break;
+            }
+        }
+        selectAccountForNextStart(target);
+        ZgConfig.restart(ApplicationLoader.applicationContext);
+    }
+
+    public static boolean hasOtherSignedInAccount(int account) {
+        for (int a = 0; a < UserConfig.MAX_ACCOUNT_COUNT; a++) {
+            if (a != account && UserConfig.getInstance(a).isClientActivated()) {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    public static void openMain(BaseFragment from) {
+        Bundle args = new Bundle();
+        args.putBoolean("afterSignup", false);
+        MainTabsActivity tabs = new MainTabsActivity();
+        tabs.prepareDialogsActivity(args);
+        from.presentFragment(tabs, true);
+        NotificationCenter.getInstance(from.getCurrentAccount()).postNotificationName(NotificationCenter.mainUserInfoChanged);
+    }
+}
