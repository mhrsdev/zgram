+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ApplicationLoader;
+import org.telegram.messenger.FileLog;
+import org.telegram.messenger.R;
+import org.telegram.messenger.UserConfig;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.tgnet.TLObject;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.ActionBar.Theme;
+
+import java.util.EnumMap;
+import java.util.Map;
+
+/**
+ * Sign-in / registration / recovery with an authenticator app (TOTP). Replaces the phone-number login:
+ * there is no SMS, fixed password, e-mail verification or Google account anywhere in the flow.
+ */
+public class ZgAuthActivity extends BaseFragment {
+
+    private static final int PAGE_LOGIN = 1;
+    private static final int PAGE_REGISTER = 2;
+    private static final int PAGE_ACTIVATE = 3;
+    private static final int PAGE_CODES = 4;
+    private static final int PAGE_RECOVER = 5;
+
+    private FrameLayout root;
+    private LinearLayout content;
+    private TextView errorView;
+    private Button primaryButton;
+    private boolean busy;
+    private int page;
+
+    // state carried between pages
+    private String pendingUsername = "";
+    private TL_zg.Registration registration;
+    private TL_zg.Activated activated;
+
+    // fields
+    private EditText usernameField;
+    private EditText codeField;
+    private EditText displayNameField;
+    private EditText emailField;
+    private EditText recoveryField;
+
+    public ZgAuthActivity() {
+        super();
+    }
+
+    @Override
+    public View createView(Context context) {
+        actionBar.setAddToContainer(false);
+        root = new FrameLayout(context);
+        root.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite));
+        ScrollView scroll = new ScrollView(context);
+        scroll.setFillViewport(true);
+        content = new LinearLayout(context);
+        content.setOrientation(LinearLayout.VERTICAL);
+        int pad = AndroidUtilities.dp(24);
+        content.setPadding(pad, AndroidUtilities.dp(48) + AndroidUtilities.statusBarHeight, pad, pad);
+        scroll.addView(content, new ScrollView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        root.addView(scroll, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        fragmentView = root;
+        show(PAGE_LOGIN);
+        return fragmentView;
+    }
+
+    @Override
+    public boolean onBackPressed(boolean invoked) {
+        if (busy) {
+            return false;
+        }
+        if (page == PAGE_REGISTER || page == PAGE_RECOVER) {
+            show(PAGE_LOGIN);
+            return false;
+        }
+        if (page == PAGE_ACTIVATE) {
+            show(PAGE_LOGIN);
+            return false;
+        }
+        return page != PAGE_CODES;
+    }
+
+    // ------------------------------------------------------------------ page plumbing
+
+    private void show(int newPage) {
+        page = newPage;
+        content.removeAllViews();
+        errorView = null;
+        switch (newPage) {
+            case PAGE_REGISTER:
+                buildRegister();
+                break;
+            case PAGE_ACTIVATE:
+                buildActivate();
+                break;
+            case PAGE_CODES:
+                buildCodes();
+                break;
+            case PAGE_RECOVER:
+                buildRecover();
+                break;
+            default:
+                buildLogin();
+        }
+    }
+
+    private Context ctx() {
+        return fragmentView.getContext();
+    }
+
+    private TextView title(String text) {
+        TextView t = new TextView(ctx());
+        t.setText(text);
+        t.setTextSize(24);
+        t.setTypeface(Typeface.DEFAULT_BOLD);
+        t.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));
+        t.setPadding(0, 0, 0, AndroidUtilities.dp(8));
+        content.addView(t);
+        return t;
+    }
+
+    private TextView body(String text) {
+        TextView t = new TextView(ctx());
+        t.setText(text);
+        t.setTextSize(15);
+        t.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText));
+        t.setPadding(0, 0, 0, AndroidUtilities.dp(12));
+        t.setLineSpacing(AndroidUtilities.dp(2), 1f);
+        content.addView(t);
+        return t;
+    }
+
+    private EditText field(String hint, int inputType, int maxLength) {
+        EditText e = new EditText(ctx());
+        e.setHint(hint);
+        e.setInputType(inputType);
+        e.setSingleLine(inputType != (InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE));
+        e.setTextSize(17);
+        e.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));
+        e.setHintTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteHintText));
+        if (maxLength > 0) {
+            e.setFilters(new InputFilter[]{new InputFilter.LengthFilter(maxLength)});
+        }
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        lp.topMargin = AndroidUtilities.dp(8);
+        content.addView(e, lp);
+        return e;
+    }
+
+    private Button button(String text, Runnable onClick, boolean primary) {
+        Button b = new Button(ctx());
+        b.setText(text);
+        b.setAllCaps(false);
+        b.setTextSize(16);
+        if (primary) {
+            b.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText));
+            b.setBackground(Theme.createSimpleSelectorRoundRectDrawable(AndroidUtilities.dp(8),
+                    Theme.getColor(Theme.key_featuredStickers_addButton), Theme.getColor(Theme.key_featuredStickers_addButtonPressed)));
+        } else {
+            b.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText4));
+            b.setBackgroundColor(Color.TRANSPARENT);
+        }
+        b.setOnClickListener(v -> {
+            if (!busy) {
+                onClick.run();
+            }
+        });
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, AndroidUtilities.dp(primary ? 50 : 44));
+        lp.topMargin = AndroidUtilities.dp(primary ? 20 : 4);
+        content.addView(b, lp);
+        if (primary) {
+            primaryButton = b;
+        }
+        return b;
+    }
+
+    private void errorLine() {
+        errorView = new TextView(ctx());
+        errorView.setTextColor(Theme.getColor(Theme.key_text_RedRegular));
+        errorView.setTextSize(14);
+        errorView.setPadding(0, AndroidUtilities.dp(10), 0, 0);
+        errorView.setVisibility(View.GONE);
+        content.addView(errorView);
+    }
+
+    private void showError(String message) {
+        if (errorView == null) {
+            return;
+        }
+        errorView.setText(message);
+        errorView.setVisibility(message == null ? View.GONE : View.VISIBLE);
+    }
+
+    private void setBusy(boolean value) {
+        busy = value;
+        if (primaryButton != null) {
+            primaryButton.setEnabled(!value);
+            primaryButton.setAlpha(value ? 0.5f : 1f);
+        }
+    }
+
+    private String str(int res) {
+        return ctx().getString(res);
+    }
+
+    private static String text(EditText e) {
+        return e == null || e.getText() == null ? "" : e.getText().toString().trim();
+    }
+
+    // ------------------------------------------------------------------ pages
+
+    private void buildLogin() {
+        title(str(R.string.ZgLoginTitle));
+        body(str(R.string.ZgLoginSubtitle));
+        usernameField = field(str(R.string.ZgHintUsername), InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_VISIBLE_PASSWORD | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS, 32);
+        codeField = field(str(R.string.ZgHintCode), InputType.TYPE_CLASS_NUMBER, 12);
+        errorLine();
+        button(str(R.string.ZgLoginButton), this::onLogin, true);
+        button(str(R.string.ZgGoRegister), () -> show(PAGE_REGISTER), false);
+        button(str(R.string.ZgGoRecover), () -> show(PAGE_RECOVER), false);
+        button(str(R.string.ZgOwnerOtherServer), () -> ZgSession.abandonAccountAndRestart(currentAccount), false);
+        if (pendingUsername.length() > 0) {
+            usernameField.setText(pendingUsername);
+        }
+    }
+
+    private void onLogin() {
+        String username = text(usernameField);
+        String code = text(codeField);
+        if (username.isEmpty() || code.isEmpty()) {
+            showError(str(R.string.ZgErrFill));
+            return;
+        }
+        pendingUsername = username;
+        TL_zg.login request = new TL_zg.login();
+        request.username = username;
+        request.code = code;
+        call(request, (TLObject response) -> {
+            if (response instanceof TLRPC.TL_auth_authorization) {
+                ZgSession.completeLogin(currentAccount, ((TLRPC.TL_auth_authorization) response).user, () -> goToMain());
+            } else {
+                showError(String.format(str(R.string.ZgErrGeneric), "response"));
+            }
+        });
+    }
+
+    private void buildRegister() {
+        title(str(R.string.ZgRegisterTitle));
+        usernameField = field(str(R.string.ZgHintUsername), InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_VISIBLE_PASSWORD | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS, 32);
+        displayNameField = field(str(R.string.ZgHintDisplayName), InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_CAP_WORDS, 64);
+        emailField = field(str(R.string.ZgHintEmail), InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_EMAIL_ADDRESS, 254);
+        TextView note = body(str(R.string.ZgEmailNote));
+        note.setTextSize(13);
+        errorLine();
+        button(str(R.string.ZgContinue), this::onRegister, true);
+        button(str(R.string.ZgGoLogin), () -> show(PAGE_LOGIN), false);
+    }
+
+    private void onRegister() {
+        String username = text(usernameField);
+        String name = text(displayNameField);
+        String email = text(emailField);
+        if (username.isEmpty() || name.isEmpty() || email.isEmpty()) {
+            showError(str(R.string.ZgErrFill));
+            return;
+        }
+        pendingUsername = username;
+        TL_zg.register request = new TL_zg.register();
+        request.username = username;
+        request.display_name = name;
+        request.email = email;
+        call(request, (TLObject response) -> {
+            if (response instanceof TL_zg.Registration) {
+                registration = (TL_zg.Registration) response;
+                show(PAGE_ACTIVATE);
+            }
+        });
+    }
+
+    private void buildRecover() {
+        title(str(R.string.ZgRecoverTitle));
+        body(str(R.string.ZgRecoverHelp));
+        usernameField = field(str(R.string.ZgHintUsername), InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_VARIATION_VISIBLE_PASSWORD | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS, 32);
+        recoveryField = field(str(R.string.ZgHintRecoveryCode), InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_CAP_CHARACTERS | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS, 40);
+        errorLine();
+        button(str(R.string.ZgRecoverButton), this::onRecover, true);
+        button(str(R.string.ZgGoLogin), () -> show(PAGE_LOGIN), false);
+        if (pendingUsername.length() > 0) {
+            usernameField.setText(pendingUsername);
+        }
+    }
+
+    private void onRecover() {
+        String username = text(usernameField);
+        String code = text(recoveryField);
+        if (username.isEmpty() || code.isEmpty()) {
+            showError(str(R.string.ZgErrFill));
+            return;
+        }
+        pendingUsername = username;
+        TL_zg.recover request = new TL_zg.recover();
+        request.username = username;
+        request.recovery_code = code;
+        call(request, (TLObject response) -> {
+            if (response instanceof TL_zg.Registration) {
+                registration = (TL_zg.Registration) response;
+                show(PAGE_ACTIVATE);
+            }
+        });
+    }
+
+    private void buildActivate() {
+        title(str(R.string.ZgActivateTitle));
+        body(str(R.string.ZgActivateHelp));
+
+        ImageView qr = new ImageView(ctx());
+        Bitmap bitmap = renderQr(registration.otpauth_uri, AndroidUtilities.dp(240));
+        if (bitmap != null) {
+            qr.setImageBitmap(bitmap);
+        }
+        qr.setBackgroundColor(Color.WHITE);
+        qr.setPadding(AndroidUtilities.dp(8), AndroidUtilities.dp(8), AndroidUtilities.dp(8), AndroidUtilities.dp(8));
+        LinearLayout.LayoutParams qlp = new LinearLayout.LayoutParams(AndroidUtilities.dp(256), AndroidUtilities.dp(256));
+        qlp.gravity = Gravity.CENTER_HORIZONTAL;
+        content.addView(qr, qlp);
+
+        TextView keyLabel = body(str(R.string.ZgManualKey));
+        keyLabel.setPadding(0, AndroidUtilities.dp(14), 0, AndroidUtilities.dp(2));
+        TextView key = new TextView(ctx());
+        key.setText(groupKey(registration.manual_key));
+        key.setTypeface(Typeface.MONOSPACE);
+        key.setTextSize(18);
+        key.setTextIsSelectable(true);
+        key.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));
+        content.addView(key);
+        button(str(R.string.ZgCopy), () -> copy(registration.manual_key), false);
+        button(str(R.string.ZgOpenAuthenticator), () -> {
+            try {
+                Intent intent = new Intent(Intent.ACTION_VIEW, android.net.Uri.parse(registration.otpauth_uri));
+                getParentActivity().startActivity(intent);
+            } catch (Exception e) {
+                FileLog.e(e);
+            }
+        }, false);
+
+        codeField = field(str(R.string.ZgHintCode), InputType.TYPE_CLASS_NUMBER, 12);
+        errorLine();
+        button(str(R.string.ZgActivateButton), this::onActivate, true);
+    }
+
+    private void onActivate() {
+        String code = text(codeField);
+        if (code.isEmpty()) {
+            showError(str(R.string.ZgErrFill));
+            return;
+        }
+        TL_zg.activate request = new TL_zg.activate();
+        request.username = registration.username;
+        request.code = code;
+        call(request, (TLObject response) -> {
+            if (response instanceof TL_zg.Activated) {
+                activated = (TL_zg.Activated) response;
+                show(PAGE_CODES);
+            }
+        });
+    }
+
+    private void buildCodes() {
+        title(str(R.string.ZgCodesTitle));
+        body(str(R.string.ZgCodesHelp));
+        StringBuilder all = new StringBuilder();
+        for (String c : activated.recovery_codes) {
+            all.append(c).append('\n');
+        }
+        TextView codes = new TextView(ctx());
+        codes.setText(all.toString().trim());
+        codes.setTypeface(Typeface.MONOSPACE);
+        codes.setTextSize(18);
+        codes.setTextIsSelectable(true);
+        codes.setLineSpacing(AndroidUtilities.dp(4), 1f);
+        codes.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));
+        content.addView(codes);
+        button(str(R.string.ZgCopy), () -> copy(all.toString().trim()), false);
+        button(str(R.string.ZgShare), () -> {
+            Intent send = new Intent(Intent.ACTION_SEND);
+            send.setType("text/plain");
+            send.putExtra(Intent.EXTRA_TEXT, all.toString().trim());
+            getParentActivity().startActivity(Intent.createChooser(send, null));
+        }, false);
+        CheckBox saved = new CheckBox(ctx());
+        saved.setText(str(R.string.ZgCodesSaved));
+        saved.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));
+        content.addView(saved);
+        button(str(R.string.ZgContinue), () -> {
+            if (!saved.isChecked()) {
+                saved.requestFocus();
+                Toast.makeText(ctx(), str(R.string.ZgCodesSaved), Toast.LENGTH_SHORT).show();
+                return;
+            }
+            TLRPC.TL_auth_authorization auth = (TLRPC.TL_auth_authorization) activated.authorization;
+            ZgSession.completeLogin(currentAccount, auth.user, this::goToMain);
+        }, true);
+    }
+
+    // ------------------------------------------------------------------ helpers
+
+    private void goToMain() {
+        ZgSession.openMain(this);
+    }
+
+    private interface Done {
+        void run(TLObject response);
+    }
+
+    private void call(TLObject request, Done done) {
+        showError(null);
+        setBusy(true);
+        ConnectionsManager.getInstance(currentAccount).sendRequest(request, (response, error) ->
+                AndroidUtilities.runOnUIThread(() -> {
+                    setBusy(false);
+                    if (error != null) {
+                        showError(describe(error));
+                    } else {
+                        done.run(response);
+                    }
+                }), ConnectionsManager.RequestFlagFailOnServerErrors | ConnectionsManager.RequestFlagWithoutLogin);
+    }
+
+    private String describe(TLRPC.TL_error error) {
+        String text = error.text == null ? "" : error.text;
+        if (text.startsWith("FLOOD_WAIT_")) {
+            int seconds = 60;
+            try {
+                seconds = Integer.parseInt(text.substring("FLOOD_WAIT_".length()));
+            } catch (NumberFormatException ignore) {
+            }
+            String when = seconds >= 120 ? (seconds / 60) + " min" : seconds + " s";
+            return String.format(str(R.string.ZgErrFlood), when);
+        }
+        switch (text) {
+            case "USERNAME_INVALID":
+                return str(R.string.ZgErrUsernameInvalid);
+            case "USERNAME_OCCUPIED":
+                return str(R.string.ZgErrUsernameOccupied);
+            case "FIRSTNAME_INVALID":
+                return str(R.string.ZgErrNameInvalid);
+            case "EMAIL_INVALID":
+                return str(R.string.ZgErrEmailInvalid);
+            case "CODE_INVALID":
+                return str(R.string.ZgErrCodeInvalid);
+            default:
+                if (error.code == -1000 || error.code == -2000 || error.code == -3000) {
+                    return str(R.string.ZgErrNetwork);
+                }
+                return String.format(str(R.string.ZgErrGeneric), text.isEmpty() ? String.valueOf(error.code) : text);
+        }
+    }
+
+    private void copy(String value) {
+        ClipboardManager clipboard = (ClipboardManager) ctx().getSystemService(Context.CLIPBOARD_SERVICE);
+        clipboard.setPrimaryClip(ClipData.newPlainText("zerogram", value));
+        Toast.makeText(ctx(), str(R.string.ZgCopied), Toast.LENGTH_SHORT).show();
+    }
+
+    private static String groupKey(String key) {
+        StringBuilder out = new StringBuilder();
+        for (int i = 0; i < key.length(); i++) {
+            if (i > 0 && i % 4 == 0) {
+                out.append(' ');
+            }
+            out.append(key.charAt(i));
+        }
+        return out.toString();
+    }
+
+    static Bitmap renderQr(String contents, int sizePx) {
+        try {
+            Map<EncodeHintType, Object> hints = new EnumMap<>(EncodeHintType.class);
+            hints.put(EncodeHintType.ERROR_CORRECTION, ErrorCorrectionLevel.M);
+            hints.put(EncodeHintType.MARGIN, 1);
+            BitMatrix matrix = new QRCodeWriter().encode(contents, BarcodeFormat.QR_CODE, sizePx, sizePx, hints);
+            int w = matrix.getWidth();
+            int h = matrix.getHeight();
+            int[] pixels = new int[w * h];
+            for (int y = 0; y < h; y++) {
+                for (int x = 0; x < w; x++) {
+                    pixels[y * w + x] = matrix.get(x, y) ? Color.BLACK : Color.WHITE;
+                }
+            }
+            Bitmap bitmap = Bitmap.createBitmap(w, h, Bitmap.Config.ARGB_8888);
+            bitmap.setPixels(pixels, 0, w, 0, 0, w, h);
+            return bitmap;
+        } catch (Exception e) {
+            FileLog.e(e);
+            return null;
+        }
+    }
+}
