@@ -0,0 +1,90 @@
+package org.telegram.zerogram;
+
+import android.widget.LinearLayout;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.R;
+import org.telegram.tgnet.TLObject;
+import org.telegram.ui.ActionBar.AlertDialog;
+
+/**
+ * Server management for the owner: the encrypted connection message to give to users, and every group with
+ * its random 32-digit join token (a person with the message and a token can join that group).
+ */
+public class ZgOwnerPanelActivity extends ZgPageFragment {
+
+    private TL_zg.OwnerInfo info;
+
+    public ZgOwnerPanelActivity() {
+        super();
+    }
+
+    @Override
+    protected void onCreateContent() {
+        load();
+    }
+
+    private void load() {
+        clear();
+        title(str(R.string.ZgOwnerPanelTitle));
+        errorLine();
+        call(new TL_zg.getOwnerInfo(), false, (TLObject response) -> {
+            if (response instanceof TL_zg.OwnerInfo) {
+                info = (TL_zg.OwnerInfo) response;
+                ZgConfig.updateName(currentAccount, info.server_name);
+                render();
+            }
+        });
+    }
+
+    private void render() {
+        clear();
+        title(str(R.string.ZgOwnerPanelTitle));
+        body(info.server_name);
+
+        body(str(R.string.ZgOwnerMessageTitle)).setTextColor(org.telegram.ui.ActionBar.Theme.getColor(org.telegram.ui.ActionBar.Theme.key_windowBackgroundWhiteBlackText));
+        body(str(R.string.ZgOwnerMessageHelp));
+        mono(info.connect_message);
+        button(str(R.string.ZgCopy), () -> copy(info.connect_message), false);
+        button(str(R.string.ZgShare), () -> share(info.connect_message), false);
+
+        body("").setPadding(0, AndroidUtilities.dp(10), 0, 0);
+        body(str(R.string.ZgOwnerGroupsTitle)).setTextColor(org.telegram.ui.ActionBar.Theme.getColor(org.telegram.ui.ActionBar.Theme.key_windowBackgroundWhiteBlackText));
+        body(str(R.string.ZgOwnerGroupsHelp));
+        if (info.groups.isEmpty()) {
+            body(str(R.string.ZgOwnerNoGroups));
+        }
+        for (TL_zg.GroupToken group : info.groups) {
+            addGroup(group);
+        }
+        errorLine();
+        button(str(R.string.ZgRefresh), this::load, false);
+    }
+
+    private void addGroup(TL_zg.GroupToken group) {
+        title(group.title.isEmpty() ? "—" : group.title).setTextSize(18);
+        body(String.format(str(R.string.ZgMembers), group.members));
+        mono(groupDigits(group.token));
+        button(str(R.string.ZgCopy), () -> copy(group.token), false);
+        button(str(R.string.ZgInviteShare), () -> share(
+                str(R.string.ZgInviteHeader) + "\n\n" + str(R.string.ZgOwnerMessageTitle) + ":\n" + info.connect_message
+                        + "\n\n" + str(R.string.ZgGroupTokenLabel) + ":\n" + groupDigits(group.token)), false);
+        button(str(R.string.ZgRotate), () -> confirmRotate(group), false);
+    }
+
+    private void confirmRotate(TL_zg.GroupToken group) {
+        if (getParentActivity() == null) {
+            return;
+        }
+        AlertDialog.Builder builder = new AlertDialog.Builder(getParentActivity());
+        builder.setTitle(str(R.string.ZgRotate));
+        builder.setMessage(str(R.string.ZgRotateConfirm));
+        builder.setPositiveButton(str(R.string.OK), (dialog, which) -> {
+            TL_zg.rotateGroupToken request = new TL_zg.rotateGroupToken();
+            request.chat_id = group.chat_id;
+            call(request, false, (TLObject response) -> load());
+        });
+        builder.setNegativeButton(str(R.string.Cancel), null);
+        showDialog(builder.create());
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/zerogram/ZgPageFragment.java b/TMessagesProj/src/main/java/org/telegram/zerogram/ZgPageFragment.java
new file mode 100644
index 0000000000000000000000000000000000000000..bbb62c8ac9736fd9db8b21a656f0e1a0b87c1a48
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/zerogram/ZgPageFragment.java
@@ -0,0 +1,258 @@
+package org.telegram.zerogram;
+
+import android.content.ClipData;
+import android.content.ClipboardManager;
+import android.content.Context;
+import android.content.Intent;
+import android.graphics.Color;
+import android.graphics.Typeface;
+import android.text.InputFilter;
+import android.text.InputType;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.Button;
+import android.widget.EditText;
+import android.widget.FrameLayout;
+import android.widget.LinearLayout;
+import android.widget.ScrollView;
+import android.widget.TextView;
+import android.widget.Toast;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.tgnet.TLObject;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.ActionBar.Theme;
+
+/** A plain scrolling page with the small set of widgets the Zerogram screens need. */
+public abstract class ZgPageFragment extends BaseFragment {
+
+    protected FrameLayout root;
+    protected LinearLayout content;
+    protected TextView errorView;
+    protected Button primaryButton;
+    protected boolean busy;
+
+    protected ZgPageFragment() {
+        super();
+    }
+
+    protected ZgPageFragment(int account) {
+        super();
+        currentAccount = account;
+    }
+
+    /** Called once the views exist and again whenever a screen wants to rebuild itself. */
+    protected abstract void onCreateContent();
+
+    @Override
+    public View createView(Context context) {
+        actionBar.setAddToContainer(false);
+        root = new FrameLayout(context);
+        root.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite));
+        ScrollView scroll = new ScrollView(context);
+        scroll.setFillViewport(true);
+        content = new LinearLayout(context);
+        content.setOrientation(LinearLayout.VERTICAL);
+        int pad = AndroidUtilities.dp(24);
+        content.setPadding(pad, AndroidUtilities.dp(48) + AndroidUtilities.statusBarHeight, pad, pad);
+        scroll.addView(content, new ScrollView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+        root.addView(scroll, new FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.MATCH_PARENT));
+        fragmentView = root;
+        onCreateContent();
+        return fragmentView;
+    }
+
+    protected void clear() {
+        content.removeAllViews();
+        errorView = null;
+        primaryButton = null;
+    }
+
+    protected Context ctx() {
+        return fragmentView.getContext();
+    }
+
+    protected String str(int res) {
+        return ctx().getString(res);
+    }
+
+    protected static String text(EditText e) {
+        return e == null || e.getText() == null ? "" : e.getText().toString().trim();
+    }
+
+    protected TextView title(String text) {
+        TextView t = new TextView(ctx());
+        t.setText(text);
+        t.setTextSize(24);
+        t.setTypeface(Typeface.DEFAULT_BOLD);
+        t.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));
+        t.setPadding(0, 0, 0, AndroidUtilities.dp(8));
+        content.addView(t);
+        return t;
+    }
+
+    protected TextView body(String text) {
+        TextView t = new TextView(ctx());
+        t.setText(text);
+        t.setTextSize(15);
+        t.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText));
+        t.setPadding(0, 0, 0, AndroidUtilities.dp(12));
+        t.setLineSpacing(AndroidUtilities.dp(2), 1f);
+        content.addView(t);
+        return t;
+    }
+
+    protected TextView mono(String text) {
+        TextView t = new TextView(ctx());
+        t.setText(text);
+        t.setTypeface(Typeface.MONOSPACE);
+        t.setTextSize(15);
+        t.setTextIsSelectable(true);
+        t.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));
+        t.setPadding(0, AndroidUtilities.dp(4), 0, AndroidUtilities.dp(4));
+        content.addView(t);
+        return t;
+    }
+
+    protected EditText field(String hint, int inputType, int maxLength) {
+        EditText e = new EditText(ctx());
+        e.setHint(hint);
+        e.setInputType(inputType);
+        e.setSingleLine(inputType != (InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE));
+        e.setTextSize(17);
+        e.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));
+        e.setHintTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteHintText));
+        if (maxLength > 0) {
+            e.setFilters(new InputFilter[]{new InputFilter.LengthFilter(maxLength)});
+        }
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT);
+        lp.topMargin = AndroidUtilities.dp(8);
+        content.addView(e, lp);
+        return e;
+    }
+
+    protected Button button(String text, Runnable onClick, boolean primary) {
+        Button b = new Button(ctx());
+        b.setText(text);
+        b.setAllCaps(false);
+        b.setTextSize(16);
+        if (primary) {
+            b.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText));
+            b.setBackground(Theme.createSimpleSelectorRoundRectDrawable(AndroidUtilities.dp(8),
+                    Theme.getColor(Theme.key_featuredStickers_addButton), Theme.getColor(Theme.key_featuredStickers_addButtonPressed)));
+        } else {
+            b.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText4));
+            b.setBackgroundColor(Color.TRANSPARENT);
+        }
+        b.setOnClickListener(v -> {
+            if (!busy) {
+                onClick.run();
+            }
+        });
+        LinearLayout.LayoutParams lp = new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, AndroidUtilities.dp(primary ? 50 : 44));
+        lp.topMargin = AndroidUtilities.dp(primary ? 20 : 4);
+        content.addView(b, lp);
+        if (primary) {
+            primaryButton = b;
+        }
+        return b;
+    }
+
+    protected void errorLine() {
+        errorView = new TextView(ctx());
+        errorView.setTextColor(Theme.getColor(Theme.key_text_RedRegular));
+        errorView.setTextSize(14);
+        errorView.setPadding(0, AndroidUtilities.dp(10), 0, 0);
+        errorView.setVisibility(View.GONE);
+        content.addView(errorView);
+    }
+
+    protected void showError(String message) {
+        if (errorView == null) {
+            return;
+        }
+        errorView.setText(message);
+        errorView.setVisibility(message == null ? View.GONE : View.VISIBLE);
+    }
+
+    protected void setBusy(boolean value) {
+        busy = value;
+        if (primaryButton != null) {
+            primaryButton.setEnabled(!value);
+            primaryButton.setAlpha(value ? 0.5f : 1f);
+        }
+    }
+
+    protected void copy(String value) {
+        ClipboardManager clipboard = (ClipboardManager) ctx().getSystemService(Context.CLIPBOARD_SERVICE);
+        clipboard.setPrimaryClip(ClipData.newPlainText("zerogram", value));
+        Toast.makeText(ctx(), str(org.telegram.messenger.R.string.ZgCopied), Toast.LENGTH_SHORT).show();
+    }
+
+    protected String paste() {
+        try {
+            ClipboardManager clipboard = (ClipboardManager) ctx().getSystemService(Context.CLIPBOARD_SERVICE);
+            ClipData clip = clipboard.getPrimaryClip();
+            if (clip != null && clip.getItemCount() > 0 && clip.getItemAt(0).getText() != null) {
+                return clip.getItemAt(0).getText().toString();
+            }
+        } catch (Throwable ignore) {
+        }
+        return "";
+    }
+
+    protected void share(String value) {
+        Intent send = new Intent(Intent.ACTION_SEND);
+        send.setType("text/plain");
+        send.putExtra(Intent.EXTRA_TEXT, value);
+        getParentActivity().startActivity(Intent.createChooser(send, null));
+    }
+
+    protected interface Done {
+        void run(TLObject response);
+    }
+
+    /** Sends a request over this page's account; errors are shown in the error line. */
+    protected void call(TLObject request, boolean withoutLogin, Done done) {
+        showError(null);
+        setBusy(true);
+        int flags = ConnectionsManager.RequestFlagFailOnServerErrors | (withoutLogin ? ConnectionsManager.RequestFlagWithoutLogin : 0);
+        ConnectionsManager.getInstance(currentAccount).sendRequest(request, (response, error) ->
+                AndroidUtilities.runOnUIThread(() -> {
+                    setBusy(false);
+                    if (error != null) {
+                        showError(ZgErrors.describe(ctx(), error));
+                    } else {
+                        done.run(response);
+                    }
+                }), flags);
+    }
+
+    protected static String groupDigits(String token) {
+        StringBuilder out = new StringBuilder();
+        for (int i = 0; i < token.length(); i++) {
+            if (i > 0 && i % 4 == 0) {
+                out.append('-');
+            }
+            out.append(token.charAt(i));
+        }
+        return out.toString();
+    }
+
+    protected static String digitsOnly(String value) {
+        StringBuilder out = new StringBuilder();
+        for (int i = 0; i < value.length(); i++) {
+            char c = value.charAt(i);
+            if (c >= '0' && c <= '9') {
+                out.append(c);
+            }
+        }
+        return out.toString();
+    }
+
+    protected static boolean isError(TLRPC.TL_error error, String text) {
+        return error != null && text.equals(error.text);
+    }
+}
