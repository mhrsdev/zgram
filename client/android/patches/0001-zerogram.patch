+package org.telegram.zerogram;
+
+import android.text.InputType;
+import android.widget.EditText;
+
+import org.telegram.messenger.R;
+
+/**
+ * Signs the owner in on a freshly added owner slot. The 12 words were typed on the welcome screen and is
+ * handed over through {@link ZgSession#takePendingOwnerWords}; if that is gone (or the proof failed) the
+ * words can be typed again here.
+ */
+public class ZgOwnerLoginActivity extends ZgPageFragment {
+
+    private EditText wordsField;
+
+    public ZgOwnerLoginActivity() {
+        super();
+    }
+
+    public ZgOwnerLoginActivity(int account) {
+        super(account);
+    }
+
+    @Override
+    protected void onCreateContent() {
+        String words = ZgSession.takePendingOwnerWords(currentAccount);
+        if (words.isEmpty()) {
+            buildForm(null);
+        } else {
+            buildConnecting();
+            start(words);
+        }
+    }
+
+    private void buildConnecting() {
+        clear();
+        title(str(R.string.ZgOwnerConnecting));
+    }
+
+    private void buildForm(String error) {
+        clear();
+        title(str(R.string.ZgOwnerTitle));
+        body(str(R.string.ZgOwnerRetryHelp));
+        wordsField = field(str(R.string.ZgHintOwnerWords), InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS, 400);
+        wordsField.setMinLines(2);
+        button(str(R.string.ZgPaste), () -> wordsField.setText(paste().trim()), false);
+        errorLine();
+        button(str(R.string.ZgOwnerConnect), () -> {
+            String words = ZgBip39.normalize(text(wordsField));
+            if (words == null) {
+                showError(str(R.string.ZgOwnerWordsInvalid));
+            } else {
+                start(words);
+            }
+        }, true);
+        button(str(R.string.ZgOwnerOtherServer), () -> ZgSession.abandonAccountAndRestart(currentAccount), false);
+        if (error != null) {
+            showError(error);
+        }
+    }
+
+    private void start(String words) {
+        ZgConfig.Endpoint endpoint = ZgConfig.read(currentAccount);
+        if (endpoint == null) {
+            ZgSession.abandonAccountAndRestart(currentAccount);
+            return;
+        }
+        showError(null);
+        setBusy(true);
+        ZgOwner.login(currentAccount, endpoint, words, (authorization, error) -> {
+            setBusy(false);
+            if (error != null || authorization == null) {
+                String message = error == null ? str(R.string.ZgOwnerBadLogin) : ZgErrors.describe(ctx(), error);
+                buildForm(message);
+                return;
+            }
+            ZgSession.completeLogin(currentAccount, authorization.user, () -> ZgSession.openMain(this));
+        });
+    }
+
+    @Override
+    public boolean onBackPressed(boolean invoked) {
+        return !busy;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/zerogram/ZgOwnerPanelActivity.java b/TMessagesProj/src/main/java/org/telegram/zerogram/ZgOwnerPanelActivity.java
