+bool ConnectionsManager::readZerogramConfig() {
+    // zerogram.properties: zg.host, zg.port, zg.pem (base64 of a PKCS#1 RSAPublicKey, one line),
+    // zg.fingerprint (16 hex digits). Written by the app's server-setup screen.
+    std::ifstream stream(currentConfigPath + "zerogram.properties");
+    if (!stream.is_open()) {
+        return false;
+    }
+    std::string line, host, pem, fingerprint;
+    uint32_t port = 0;
+    while (std::getline(stream, line)) {
+        size_t separator = line.find('=');
+        if (separator == std::string::npos) {
+            continue;
+        }
+        std::string key = line.substr(0, separator);
+        std::string value = line.substr(separator + 1);
+        while (!value.empty() && (value.back() == '\r' || value.back() == '\n' || value.back() == ' ')) {
+            value.pop_back();
+        }
+        if (key == "zg.host") {
+            host = value;
+        } else if (key == "zg.port") {
+            port = (uint32_t) std::strtoul(value.c_str(), nullptr, 10);
+        } else if (key == "zg.pem") {
+            pem = value;
+        } else if (key == "zg.fingerprint") {
+            fingerprint = value;
+        }
+    }
+    if (host.empty() || port == 0 || port > 65535 || pem.empty() || fingerprint.size() != 16) {
+        return false;
+    }
+    std::string armored = "-----BEGIN RSA PUBLIC KEY-----\n";
+    for (size_t i = 0; i < pem.size(); i += 64) {
+        armored += pem.substr(i, 64) + "\n";
+    }
+    armored += "-----END RSA PUBLIC KEY-----";
+    zgHost = host;
+    zgPort = port;
+    zgPublicKeyPem = armored;
+    zgPublicKeyFingerprint = (uint64_t) std::strtoull(fingerprint.c_str(), nullptr, 16);
+    zgConfigured = true;
+    return true;
+}
