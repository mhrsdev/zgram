@@ -0,0 +1,45 @@
+package org.telegram.zerogram;
+
+import org.telegram.messenger.AccountInstance;
+import org.telegram.messenger.UserConfig;
+import org.telegram.tgnet.ConnectionsManager;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.tgnet.tl.TL_update;
+
+import java.util.ArrayList;
+
+/**
+ * Delivery status. The sender's second check means "delivered to the recipient's device" (the recipient's
+ * app acknowledged it after storing it locally); there are no read receipts. Live changes arrive as a normal
+ * outbox update; this sync catches up on marks that happened while this device was offline.
+ */
+public final class ZgDelivery {
+
+    private ZgDelivery() {
+    }
+
+    public static void sync(int account) {
+        if (!UserConfig.getInstance(account).isClientActivated()) {
+            return;
+        }
+        ConnectionsManager.getInstance(account).sendRequest(new TL_zg.getDeliveryState(), (response, error) -> {
+            if (!(response instanceof TL_zg.DeliveryState)) {
+                return;
+            }
+            TL_zg.DeliveryState state = (TL_zg.DeliveryState) response;
+            ArrayList<TLRPC.Update> updates = new ArrayList<>();
+            for (TL_zg.DeliveryMark mark : state.marks) {
+                if (mark.peer == null || mark.max_id <= 0) {
+                    continue;
+                }
+                TL_update.TL_updateReadHistoryOutbox update = new TL_update.TL_updateReadHistoryOutbox();
+                update.peer = mark.peer;
+                update.max_id = mark.max_id;
+                updates.add(update);
+            }
+            if (!updates.isEmpty()) {
+                AccountInstance.getInstance(account).getMessagesController().processUpdateArray(updates, null, null, false, 0);
+            }
+        });
+    }
+}
