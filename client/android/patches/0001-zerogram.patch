+        public TLRPC.auth_Authorization deserializeResponseT(InputSerializedData stream, int constructor, boolean exception) {
+            return TLRPC.auth_Authorization.TLdeserialize(stream, constructor, exception);
+        }
+
+        @Override
+        public void serializeToStream(OutputSerializedData stream) {
+            stream.writeInt32(constructor);
+            stream.writeByteArray(client_nonce);
+            stream.writeByteArray(server_nonce);
+            stream.writeByteArray(client_proof);
+        }
+    }
+
+    public static class getOwnerInfo extends TLMethod<OwnerInfo> {
+        public static final int constructor = 0xb2801d1e;
+
+        @Override
+        public OwnerInfo deserializeResponseT(InputSerializedData stream, int constructor, boolean exception) {
+            return OwnerInfo.TLdeserialize(stream, constructor, exception);
+        }
+
+        @Override
+        public void serializeToStream(OutputSerializedData stream) {
+            stream.writeInt32(constructor);
+        }
+    }
+
+    public static class getGroupToken extends TLMethod<GroupToken> {
+        public static final int constructor = 0x36dbb88a;
+
+        public long chat_id;
+
+        @Override
+        public GroupToken deserializeResponseT(InputSerializedData stream, int constructor, boolean exception) {
+            return GroupToken.TLdeserialize(stream, constructor, exception);
+        }
+
+        @Override
+        public void serializeToStream(OutputSerializedData stream) {
+            stream.writeInt32(constructor);
+            stream.writeInt64(chat_id);
+        }
+    }
+
+    public static class rotateGroupToken extends TLMethod<GroupToken> {
+        public static final int constructor = 0x478a1fe1;
+
+        public long chat_id;
+
+        @Override
+        public GroupToken deserializeResponseT(InputSerializedData stream, int constructor, boolean exception) {
+            return GroupToken.TLdeserialize(stream, constructor, exception);
+        }
+
+        @Override
+        public void serializeToStream(OutputSerializedData stream) {
+            stream.writeInt32(constructor);
+            stream.writeInt64(chat_id);
+        }
+    }
+
+    public static class joinGroup extends TLMethod<TLRPC.Updates> {
+        public static final int constructor = 0x03c02002;
+
+        public String token;
+
+        @Override
+        public TLRPC.Updates deserializeResponseT(InputSerializedData stream, int constructor, boolean exception) {
+            return TLRPC.Updates.TLdeserialize(stream, constructor, exception);
+        }
+
+        @Override
+        public void serializeToStream(OutputSerializedData stream) {
+            stream.writeInt32(constructor);
+            stream.writeString(token);
+        }
+    }
+}
